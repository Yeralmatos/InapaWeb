@{
    ViewData["Title"] = "Reclamación Individual";
}


<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header text-white"
             style="background:#0752b3">

            <h3 class="mb-0">
                👤 Reclamación Individual
            </h3>

        </div>


        <div class="card-body">

            <p class="text-muted">
                Registro y gestión de reclamaciones realizadas por un cliente.
            </p>


            <div class="row mt-4">


                <div class="col-md-4 mb-3">

                    <div class="card shadow-sm text-center">

                        <div class="card-body">

                            <i class="bi bi-person-fill"
                               style="font-size:45px;color:#0752b3">
                            </i>


                            <h5 class="mt-3">
                                Nueva Reclamación
                            </h5>


                            <p>
                                Registrar una nueva reclamación individual.
                            </p>


                            <button class="btn btn-outline-primary">
                                Crear
                            </button>

                        </div>

                    </div>

                </div>



                <div class="col-md-4 mb-3">

                    <div class="card shadow-sm text-center">

                        <div class="card-body">

                            <i class="bi bi-search"
                               style="font-size:45px;color:#0752b3">
                            </i>


                            <h5 class="mt-3">
                                Consultar
                            </h5>


                            <p>
                                Buscar reclamaciones registradas.
                            </p>


                            <button class="btn btn-outline-primary">
                                Buscar
                            </button>

                        </div>

                    </div>

                </div>



                <div class="col-md-4 mb-3">

                    <div class="card shadow-sm text-center">

                        <div class="card-body">

                            <i class="bi bi-check-circle-fill"
                               style="font-size:45px;color:#0752b3">
                            </i>


                            <h5 class="mt-3">
                                Seguimiento
                            </h5>


                            <p>
                                Revisar estado y solución.
                            </p>


                            <button class="btn btn-outline-primary">
                                Ver
                            </button>

                        </div>

                    </div>

                </div>


            </div>



            <div class="text-center mt-4">

                <a asp-controller="Admin"
                   asp-action="Reclamaciones"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-left"></i>
                    Volver a Reclamaciones

                </a>

            </div>


        </div>

    </div>

</div>