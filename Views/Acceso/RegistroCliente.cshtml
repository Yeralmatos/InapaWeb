@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Registro de Cliente - INAPA</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background: #f4f7fb;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        .card {
            max-width: 850px;
            margin: 35px auto;
            border: none;
            border-radius: 18px;
            box-shadow: 0 10px 35px rgba(0,0,0,.08);
        }

        .logo {
            width: 95px;
            height: 95px;
            object-fit: contain;
        }

        .section-title {
            font-weight: 700;
            color: #0d6efd;
            margin-top: 15px;
            margin-bottom: 10px;
            border-bottom: 1px solid #e5eaf1;
            padding-bottom: 6px;
        }

        .btn-register {
            background: #0d6efd;
            color: white;
            font-weight: 600;
        }

            .btn-register:hover {
                background: #0b5ed7;
                color: white;
            }
    </style>
</head>

<body>

    <div class="card">
        <div class="card-body p-4">

            <div class="text-center mb-3">
                <img src="/images/inapa-logo.png?v=1002" class="logo" alt="Logo INAPA" />
                <h3 class="mt-2">Registro de Cliente</h3>
                <p class="text-muted">Complete sus datos para solicitar acceso al sistema</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger text-center">
                    @ViewBag.Error
                </div>
            }

            @if (ViewBag.Mensaje != null)
            {
                <div class="alert alert-success text-center">
                    @ViewBag.Mensaje
                </div>
            }

            <form asp-action="RegistroCliente" method="post">

                <div class="section-title">
                    <i class="bi bi-person-fill"></i> Datos de acceso
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label>Nombre completo</label>
                        <input name="nombreUsuario" class="form-control" placeholder="Ingrese su nombre completo" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Correo electrónico</label>
                        <input name="correo" type="email" class="form-control" placeholder="ejemplo@correo.com" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Contraseña</label>
                        <input name="contrasena" type="password" class="form-control" placeholder="Cree una contraseña" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Cédula / Pasaporte / RNC</label>
                        <input name="cedulaPasaporteRnc" class="form-control" placeholder="Ingrese su documento" required />
                    </div>
                </div>

                <div class="section-title">
                    <i class="bi bi-geo-alt-fill"></i> Datos del servicio
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label>Teléfono</label>
                        <input name="telefono" class="form-control" placeholder="809-000-0000" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Provincia</label>
                        <input name="provincia" class="form-control" placeholder="Ej: Barahona" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Municipio</label>
                        <input name="municipio" class="form-control" placeholder="Ej: Jaquimeyes" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Sector</label>
                        <input name="sector" class="form-control" placeholder="Ej: Centro" />
                    </div>

                    <div class="col-md-12 mb-3">
                        <label>Dirección exacta</label>
                        <textarea name="direccion" class="form-control" rows="3" placeholder="Calle, número de casa, referencia..." required></textarea>
                    </div>
                </div>

                <button type="submit" class="btn btn-register w-100">
                    <i class="bi bi-person-plus-fill"></i>
                    Crear cuenta
                </button>

            </form>

            <div class="text-center mt-3">
                <a asp-controller="Acceso" asp-action="Login">
                    Ya tengo una cuenta
                </a>
            </div>

        </div>
    </div>

</body>
</html>