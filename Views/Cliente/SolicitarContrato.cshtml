@model InapaWeb.Models.SolicitudContrato

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Solicitar Contrato - INAPA</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f4f7fb;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        .main-card {
            max-width: 850px;
            margin: 40px auto;
            border: none;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, .09);
            overflow: hidden;
        }

        .card-header {
            background: #06469b;
            color: white;
            padding: 22px 26px;
        }

        .form-label {
            font-weight: 600;
        }

        .information {
            background: #eef6ff;
            border-left: 5px solid #0d6efd;
            border-radius: 10px;
            padding: 16px;
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="card main-card">

            <div class="card-header">
                <h3 class="mb-1">
                    <i class="bi bi-file-earmark-plus-fill"></i>
                    Solicitar Contrato
                </h3>

                <small>
                    Completa los datos para iniciar el proceso de contratación.
                </small>
            </div>

            <div class="card-body p-4">

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.Error
                    </div>
                }

                <div class="information mb-4">
                    <i class="bi bi-info-circle-fill"></i>

                    La solicitud será revisada por el administrador.
                    Posteriormente se realizará el levantamiento técnico,
                    la categorización y la generación del contrato.
                </div>

                <form asp-controller="Cliente"
                      asp-action="SolicitarContrato"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="TipoServicio"
                               class="form-label">
                            Tipo de servicio
                        </label>

                        <select asp-for="TipoServicio"
                                class="form-select"
                                required>

                            <option value="">
                                Seleccione...
                            </option>

                            <option value="Agua potable">
                                Agua potable
                            </option>

                            <option value="Alcantarillado">
                                Alcantarillado
                            </option>

                            <option value="Agua potable y alcantarillado">
                                Agua potable y alcantarillado
                            </option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DireccionServicio"
                               class="form-label">
                            Dirección donde se instalará el servicio
                        </label>

                        <input asp-for="DireccionServicio"
                               class="form-control"
                               maxlength="200"
                               required />
                    </div>

                    <div class="mb-4">
                        <label asp-for="ObservacionCliente"
                               class="form-label">
                            Observaciones
                        </label>

                        <textarea asp-for="ObservacionCliente"
                                  class="form-control"
                                  rows="5"
                                  maxlength="500"
                                  placeholder="Escriba información adicional sobre la solicitud..."></textarea>
                    </div>

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary"
                                onclick="return confirm('¿Deseas enviar esta solicitud de contrato?');">

                            <i class="bi bi-send-fill"></i>
                            Enviar solicitud
                        </button>

                        <a asp-controller="Cliente"
                           asp-action="MiContrato"
                           class="btn btn-secondary">

                            <i class="bi bi-arrow-left"></i>
                            Cancelar
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>

</body>
</html>
