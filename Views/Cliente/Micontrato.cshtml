@model InapaWeb.Models.Contrato

@{
    Layout = null;
    var nombreUsuario = ViewBag.NombreUsuario ?? "Cliente";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Mi Contrato - INAPA</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #f3f6fb;
            color: #0b1f44;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        /* =====================================================
                   BARRA LATERAL
                ===================================================== */

        .sidebar {
            width: 280px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            overflow-y: auto;
            padding: 22px 16px;
            background: linear-gradient( 180deg, #063c82 0%, #06285d 55%, #031a3d 100% );
            color: white;
            box-shadow: 5px 0 25px rgba(0, 24, 64, .18);
            z-index: 1000;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 4px 8px 22px;
            border-bottom: 1px solid rgba(255, 255, 255, .15);
        }

            .brand img {
                width: 60px;
                height: 60px;
                object-fit: contain;
                flex-shrink: 0;
            }

            .brand h2 {
                margin: 0;
                font-size: 27px;
                font-weight: 800;
                letter-spacing: .5px;
            }

            .brand small {
                display: block;
                margin-top: 2px;
                font-size: 10px;
                line-height: 1.35;
                color: rgba(255, 255, 255, .78);
            }

        .client-summary {
            display: flex;
            align-items: center;
            gap: 11px;
            margin: 18px 3px;
            padding: 13px;
            border-radius: 14px;
            background: rgba(255, 255, 255, .09);
            border: 1px solid rgba(255, 255, 255, .10);
        }

        .client-avatar {
            width: 43px;
            height: 43px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ffffff;
            color: #0752b3;
            font-size: 22px;
            flex-shrink: 0;
        }

        .client-summary strong {
            display: block;
            max-width: 165px;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            font-size: 14px;
        }

        .client-summary span {
            font-size: 12px;
            color: rgba(255, 255, 255, .72);
        }

        .menu-section {
            margin: 20px 12px 8px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.4px;
            color: rgba(255, 255, 255, .48);
            text-transform: uppercase;
        }

        .menu a {
            display: flex;
            align-items: center;
            gap: 13px;
            min-height: 48px;
            margin-bottom: 5px;
            padding: 11px 13px;
            border-radius: 12px;
            color: rgba(255, 255, 255, .88);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all .2s ease;
        }

            .menu a i {
                width: 24px;
                text-align: center;
                font-size: 19px;
            }

            .menu a:hover {
                color: white;
                background: rgba(255, 255, 255, .11);
                transform: translateX(3px);
            }

            .menu a.active {
                background: #ffffff;
                color: #064594;
                font-weight: 700;
                box-shadow: 0 8px 20px rgba(0, 0, 0, .15);
            }

            .menu a.logout {
                margin-top: 16px;
                color: #ffd9d9;
                border: 1px solid rgba(255, 255, 255, .10);
            }

                .menu a.logout:hover {
                    background: #b42332;
                    color: white;
                }

        /* =====================================================
                   CONTENIDO PRINCIPAL
                ===================================================== */

        .main {
            width: calc(100% - 280px);
            min-height: 100vh;
            margin-left: 280px;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            min-height: 76px;
            padding: 12px 34px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: white;
            border-bottom: 1px solid #e2e8f0;
            box-shadow: 0 2px 12px rgba(15, 40, 80, .04);
        }

        .topbar-title h5 {
            margin: 0;
            font-weight: 750;
            color: #0b1f44;
        }

        .topbar-title small {
            color: #718096;
        }

        .topbar-user {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .topbar-avatar {
            width: 44px;
            height: 44px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e8f1ff;
            color: #0752b3;
            font-size: 22px;
        }

        .topbar-user strong {
            display: block;
            font-size: 14px;
        }

        .topbar-user small {
            color: #718096;
        }

        .content {
            flex: 1;
            padding: 32px 36px;
        }

        /* =====================================================
                   ENCABEZADO DE PÁGINA
                ===================================================== */

        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            margin-bottom: 24px;
        }

        .page-title-area {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .page-icon {
            width: 54px;
            height: 54px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #0752b3;
            color: white;
            font-size: 25px;
            box-shadow: 0 10px 22px rgba(7, 82, 179, .20);
        }

        .page-title-area h2 {
            margin: 0;
            font-size: 28px;
            font-weight: 800;
            color: #0b1f44;
        }

        .page-title-area p {
            margin: 4px 0 0;
            color: #718096;
            font-size: 14px;
        }

        .btn-panel {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 11px 16px;
            border-radius: 11px;
            border: 1px solid #d9e2ee;
            background: white;
            color: #334155;
            text-decoration: none;
            font-weight: 650;
            box-shadow: 0 5px 15px rgba(18, 43, 85, .05);
            transition: .2s;
        }

            .btn-panel:hover {
                color: #0752b3;
                border-color: #9dbbe3;
                transform: translateY(-1px);
            }

        /* =====================================================
                   TARJETA PRINCIPAL
                ===================================================== */

        .main-card {
            border: none;
            border-radius: 18px;
            overflow: hidden;
            background: white;
            box-shadow: 0 10px 30px rgba(18, 43, 85, .09);
        }

        .contract-header {
            background: linear-gradient(135deg, #0752b3, #032f78);
            color: white;
            padding: 24px 28px;
        }

            .contract-header h3 {
                margin: 0 0 5px;
                font-weight: 700;
            }

        .contract-body {
            padding: 26px;
        }

        .status-box {
            border-radius: 14px;
            padding: 24px;
            margin-bottom: 24px;
            text-align: center;
        }

            .status-box i {
                display: block;
                margin-bottom: 10px;
                font-size: 38px;
            }

        .status-empty {
            background: #e9f4ff;
            color: #084298;
            border: 1px solid #b6d4fe;
        }

        .status-pending {
            background: #fff3cd;
            color: #664d03;
            border: 1px solid #ffecb5;
        }

        .status-active {
            background: #d1e7dd;
            color: #0f5132;
            border: 1px solid #badbcc;
        }

        .status-rejected {
            background: #f8d7da;
            color: #842029;
            border: 1px solid #f5c2c7;
        }

        .info-box {
            height: 100%;
            padding: 20px;
            background: #f8fafc;
            border: 1px solid #dfe6ef;
            border-radius: 14px;
        }

            .info-box h5 {
                margin-bottom: 20px;
                font-weight: 700;
            }

        .detail-row {
            padding: 11px 0;
            border-bottom: 1px solid #e4e9ef;
        }

            .detail-row:last-child {
                padding-bottom: 0;
                border-bottom: none;
            }

        .detail-label {
            margin-bottom: 3px;
            color: #66758d;
            font-size: 13px;
        }

        .detail-value {
            font-weight: 600;
            word-break: break-word;
        }

        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 25px;
        }

        .footer {
            padding: 17px 30px;
            text-align: center;
            color: #718096;
            background: white;
            border-top: 1px solid #e4eaf2;
            font-size: 13px;
        }

        /* =====================================================
                   RESPONSIVE
                ===================================================== */

        @@media (max-width: 850px) {
            .layout {
                display: block;
            }

            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
            }

            .main {
                width: 100%;
                margin-left: 0;
            }

            .topbar {
                padding: 14px 18px;
            }

            .content {
                padding: 22px 18px;
            }

            .page-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .btn-panel {
                width: 100%;
                justify-content: center;
            }
        }

        @@media (max-width: 576px) {
            .topbar-title {
                display: none;
            }

            .page-title-area h2 {
                font-size: 24px;
            }

            .contract-header,
            .contract-body {
                padding: 18px;
            }
        }
    </style>
</head>

<body>

    <div class="layout">

        <!-- =====================================================
             BARRA LATERAL
        ====================================================== -->

        <aside class="sidebar">

            <div class="brand">

                <img src="/images/inapa-logo.png"
                     alt="Logo INAPA" />

                <div>
                    <h2>INAPA</h2>

                    <small>
                        Instituto Nacional de Aguas<br />
                        Potables y Alcantarillados
                    </small>
                </div>

            </div>

            <div class="client-summary">

                <div class="client-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div>
                    <strong>@nombreUsuario</strong>
                    <span>Portal del cliente</span>
                </div>

            </div>

            <nav class="menu">

                <div class="menu-section">
                    Principal
                </div>

                <a asp-controller="Cliente"
                   asp-action="Index">

                    <i class="bi bi-grid-fill"></i>
                    Inicio
                </a>

                <div class="menu-section">
                    Gestiones
                </div>

                <a asp-controller="Cliente"
                   asp-action="NuevaSolicitud">

                    <i class="bi bi-file-earmark-plus-fill"></i>
                    Solicitar servicio
                </a>

                <a asp-controller="Cliente"
                   asp-action="MisSolicitudes">

                    <i class="bi bi-list-check"></i>
                    Mis solicitudes
                </a>

                <a asp-controller="Cliente"
                   asp-action="MiContrato"
                   class="active">

                    <i class="bi bi-file-earmark-text-fill"></i>
                    Mi contrato
                </a>

                <div class="menu-section">
                    Facturación
                </div>

                <a href="#">

                    <i class="bi bi-receipt-cutoff"></i>
                    Mis facturas
                </a>

                <a href="#">

                    <i class="bi bi-wallet2"></i>
                    Mis pagos
                </a>

                <div class="menu-section">
                    Atención
                </div>

                <a href="#">

                    <i class="bi bi-tools"></i>
                    Reportar avería
                </a>

                <a href="#">

                    <i class="bi bi-chat-square-text-fill"></i>
                    Reclamaciones
                </a>

                <a href="#">

                    <i class="bi bi-bell-fill"></i>
                    Notificaciones
                </a>

                <div class="menu-section">
                    Cuenta
                </div>

                <a href="#">

                    <i class="bi bi-person-circle"></i>
                    Mi perfil
                </a>

                <a asp-controller="Acceso"
                   asp-action="CerrarSesion"
                   class="logout">

                    <i class="bi bi-box-arrow-left"></i>
                    Cerrar sesión
                </a>

            </nav>

        </aside>

        <!-- =====================================================
             CONTENIDO
        ====================================================== -->

        <main class="main">

            <header class="topbar">

                <div class="topbar-title">

                    <h5>Mi contrato</h5>

                    <small>
                        Consulta la información de tu contrato
                    </small>

                </div>

                <div class="topbar-user">

                    <div class="topbar-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <div>
                        <strong>@nombreUsuario</strong>
                        <small>Cliente</small>
                    </div>

                </div>

            </header>

            <section class="content">

                <div class="page-header">

                    <div class="page-title-area">

                        <div class="page-icon">
                            <i class="bi bi-file-earmark-text-fill"></i>
                        </div>

                        <div>
                            <h2>Mi Contrato</h2>

                            <p>
                                Consulta el estado y los datos de tu contrato.
                            </p>
                        </div>

                    </div>

                    <a asp-controller="Cliente"
                       asp-action="Index"
                       class="btn-panel">

                        <i class="bi bi-arrow-left"></i>
                        Volver al panel

                    </a>

                </div>

                <div class="main-card">

                    <div class="contract-header">

                        <h3>
                            <i class="bi bi-file-earmark-text-fill"></i>
                            Información del contrato
                        </h3>

                        <small>
                            Consulta la información de tu servicio contratado.
                        </small>

                    </div>

                    <div class="contract-body">

                        @if (TempData["Mensaje"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show">

                                <i class="bi bi-check-circle-fill me-1"></i>
                                @TempData["Mensaje"]

                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="alert">
                                </button>

                            </div>
                        }

                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show">

                                <i class="bi bi-exclamation-circle-fill me-1"></i>
                                @TempData["Error"]

                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="alert">
                                </button>

                            </div>
                        }

                        @if (Model == null)
                        {
                            <div class="status-box status-empty">

                                <i class="bi bi-file-earmark-plus-fill"></i>

                                <h4>
                                    Aún no tienes un contrato
                                </h4>

                                <p>
                                    Puedes solicitar un contrato para iniciar el proceso
                                    de contratación del servicio de agua potable.
                                </p>

                                <a asp-controller="Cliente"
                                   asp-action="SolicitarContrato"
                                   class="btn btn-primary">

                                    <i class="bi bi-file-earmark-plus"></i>
                                    Solicitar contrato

                                </a>

                            </div>
                        }
                        else
                        {
                            @if (Model.Estado == "Pendiente")
                            {
                                <div class="status-box status-pending">

                                    <i class="bi bi-hourglass-split"></i>

                                    <h4>
                                        Contrato pendiente
                                    </h4>

                                    <p class="mb-0">
                                        Tu contrato fue generado y está pendiente de aprobación.
                                    </p>

                                </div>
                            }
                            else if (Model.Estado == "Activo")
                            {
                                <div class="status-box status-active">

                                    <i class="bi bi-check-circle-fill"></i>

                                    <h4>
                                        Contrato activo
                                    </h4>

                                    <p class="mb-0">
                                        Tu contrato se encuentra activo.
                                    </p>

                                </div>
                            }
                            else if (Model.Estado == "Rechazado")
                            {
                                <div class="status-box status-rejected">

                                    <i class="bi bi-x-circle-fill"></i>

                                    <h4>
                                        Contrato rechazado
                                    </h4>

                                    <p class="mb-0">
                                        Comunícate con INAPA para obtener más información.
                                    </p>

                                </div>
                            }
                            else
                            {
                                <div class="alert alert-secondary text-center">

                                    Estado actual del contrato:

                                    <strong>@Model.Estado</strong>

                                </div>
                            }

                        <div class="row g-3">

                            <div class="col-md-6">

                                <div class="info-box">

                                    <h5>
                                        <i class="bi bi-file-earmark-text"></i>
                                        Datos del contrato
                                    </h5>

                                    <div class="detail-row">

                                        <div class="detail-label">
                                            Número del contrato
                                        </div>

                                        <div class="detail-value">
                                            CT-@Model.IdContrato.ToString("00000")
                                        </div>

                                    </div>

                                    <div class="detail-row">

                                        <div class="detail-label">
                                            Fecha de inicio
                                        </div>

                                            <div class="detail-value">
                                                @(Model.FechaInicioServicio.ToString("dd/MM/yyyy"))
                                            </div>

                                        </div>

                                        <div class="detail-row">

                                            <div class="detail-label">
                                                Fecha de finalización
                                            </div>

                                            <div class="detail-value">
                                                @(Model.FechaVencimiento.HasValue
                                                    ? Model.FechaVencimiento.Value.ToString("dd/MM/yyyy")
                                                    : "Sin fecha")
                                            </div>

                                    </div>

                                    <div class="detail-row">

                                        <div class="detail-label">
                                            Estado
                                        </div>

                                        <div class="detail-value">
                                            @Model.Estado
                                        </div>

                                    </div>

                                </div>

                            </div>

                            <div class="col-md-6">

                                <div class="info-box">

                                    <h5>
                                        <i class="bi bi-person-lines-fill"></i>
                                        Cliente y tarifa
                                    </h5>

                                    <div class="detail-row">

                                        <div class="detail-label">
                                            Cliente
                                        </div>

                                        <div class="detail-value">
                                            @(Model.Cliente?.Usuario?.NombreUsuario
                                                                                        ?? "No disponible")
                                                                                                       </div>

                                    </div>

                                    <div class="detail-row">

                                        <div class="detail-label">
                                            Documento
                                        </div>

                                        <div class="detail-value">
                                            @(Model.Cliente?.CedulaPasaporteRnc
                                                                                        ?? "No disponible")
                                                                                                       </div>

                                    </div>

                                    <div class="detail-row">

                                        <div class="detail-label">
                                            Categoría tarifaria
                                        </div>

                                        <div class="detail-value">
                                            @(Model.Cliente?.Tarifa?.Descripcion
                                                                                        ?? "No asignada")
                                        </div>

                                    </div>

                                    <div class="detail-row">

                                        <div class="detail-label">
                                            Monto de la tarifa
                                        </div>

                                        <div class="detail-value">
                                            RD$ @(Model.Cliente?.Tarifa?.Monto.ToString("N2")
                                                                                        ?? "0.00")
                                        </div>

                                        </div>

                                    </div>

                                </div>

                            </div>
                                                }

                        <div class="actions">

                            <a asp-controller="Cliente"
                               asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bi bi-arrow-left"></i>
                                Volver al panel
                            </a>

                            <a asp-controller="Cliente"
                               asp-action="MisSolicitudes"
                               class="btn btn-outline-primary">

                                <i class="bi bi-list-check"></i>
                                Mis solicitudes
                            </a>

                        </div>

                    </div>

                </div>

            </section>

            <footer class="footer">
                © 2026 INAPA - Instituto Nacional de Aguas Potables y Alcantarillados
            </footer>

        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>
