@{
    Layout = null;
    var nombreUsuario = ViewBag.NombreUsuario ?? "Cliente";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Panel Cliente - INAPA</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #f3f6fb;
            color: #0b1f44;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 280px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            overflow-y: auto;
            padding: 22px 16px;
            background: linear-gradient(180deg, #063c82 0%, #06285d 55%, #031a3d 100%);
            color: white;
            box-shadow: 5px 0 25px rgba(0, 24, 64, .18);
            z-index: 1000;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 4px 8px 22px;
            border-bottom: 1px solid rgba(255, 255, 255, .15);
        }

            .brand img {
                width: 60px;
                height: 60px;
                object-fit: contain;
                flex-shrink: 0;
            }

            .brand h2 {
                margin: 0;
                font-size: 27px;
                font-weight: 800;
                letter-spacing: .5px;
            }

            .brand small {
                display: block;
                margin-top: 2px;
                font-size: 10px;
                line-height: 1.35;
                color: rgba(255, 255, 255, .78);
            }

        .client-summary {
            display: flex;
            align-items: center;
            gap: 11px;
            margin: 18px 3px;
            padding: 13px;
            border-radius: 14px;
            background: rgba(255, 255, 255, .09);
            border: 1px solid rgba(255, 255, 255, .10);
        }

        .client-avatar {
            width: 43px;
            height: 43px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ffffff;
            color: #0752b3;
            font-size: 22px;
            flex-shrink: 0;
        }

        .client-summary strong {
            display: block;
            max-width: 165px;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            font-size: 14px;
        }

        .client-summary span {
            font-size: 12px;
            color: rgba(255, 255, 255, .72);
        }

        .menu-section {
            margin: 20px 12px 8px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.4px;
            color: rgba(255, 255, 255, .48);
            text-transform: uppercase;
        }

        .menu a {
            display: flex;
            align-items: center;
            gap: 13px;
            min-height: 48px;
            margin-bottom: 5px;
            padding: 11px 13px;
            border-radius: 12px;
            color: rgba(255, 255, 255, .88);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all .2s ease;
        }

            .menu a i {
                width: 24px;
                text-align: center;
                font-size: 19px;
            }

            .menu a:hover {
                color: white;
                background: rgba(255, 255, 255, .11);
                transform: translateX(3px);
            }

            .menu a.active {
                background: #ffffff;
                color: #064594;
                font-weight: 700;
                box-shadow: 0 8px 20px rgba(0, 0, 0, .15);
            }

            .menu a.logout {
                margin-top: 16px;
                color: #ffd9d9;
                border: 1px solid rgba(255, 255, 255, .10);
            }

                .menu a.logout:hover {
                    background: #b42332;
                    color: white;
                }

        .main {
            width: calc(100% - 280px);
            min-height: 100vh;
            margin-left: 280px;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            min-height: 76px;
            padding: 12px 34px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: white;
            border-bottom: 1px solid #e2e8f0;
            box-shadow: 0 2px 12px rgba(15, 40, 80, .04);
        }

        .topbar-title h5 {
            margin: 0;
            font-weight: 750;
            color: #0b1f44;
        }

        .topbar-title small {
            color: #718096;
        }

        .topbar-user {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .topbar-avatar {
            width: 44px;
            height: 44px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e8f1ff;
            color: #0752b3;
            font-size: 22px;
        }

        .topbar-user strong {
            display: block;
            font-size: 14px;
        }

        .topbar-user small {
            color: #718096;
        }

        .content {
            flex: 1;
            padding: 32px 36px;
        }

        .welcome-banner {
            position: relative;
            overflow: hidden;
            padding: 34px 35px;
            border-radius: 20px;
            background: linear-gradient(135deg, #0752b3, #073473);
            color: white;
            box-shadow: 0 15px 35px rgba(7, 82, 179, .22);
        }

            .welcome-banner::before {
                content: "";
                position: absolute;
                width: 220px;
                height: 220px;
                border-radius: 50%;
                right: -75px;
                top: -90px;
                background: rgba(255, 255, 255, .09);
            }

            .welcome-banner::after {
                content: "";
                position: absolute;
                width: 150px;
                height: 150px;
                border-radius: 50%;
                right: 85px;
                bottom: -100px;
                background: rgba(255, 255, 255, .06);
            }

        .welcome-content {
            position: relative;
            z-index: 2;
            max-width: 680px;
        }

        .welcome-banner h2 {
            margin: 0 0 10px;
            font-size: 31px;
            font-weight: 800;
        }

        .welcome-banner p {
            margin: 0;
            max-width: 640px;
            line-height: 1.65;
            color: rgba(255, 255, 255, .84);
        }

        .welcome-action {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 20px;
            padding: 11px 18px;
            border-radius: 11px;
            background: white;
            color: #0752b3;
            text-decoration: none;
            font-weight: 700;
            transition: all .2s ease;
        }

            .welcome-action:hover {
                color: #043d88;
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, .13);
            }

        .section-title {
            margin: 28px 0 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .section-title h4 {
                margin: 0;
                font-size: 20px;
                font-weight: 750;
            }

            .section-title span {
                color: #718096;
                font-size: 13px;
            }

        .stat-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 17px;
        }

        .stat-card {
            position: relative;
            overflow: hidden;
            min-height: 168px;
            padding: 21px;
            border-radius: 17px;
            background: white;
            border: 1px solid #e4eaf2;
            box-shadow: 0 7px 22px rgba(18, 43, 85, .06);
            transition: transform .2s ease, box-shadow .2s ease;
        }

            .stat-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 12px 26px rgba(18, 43, 85, .11);
            }

        .stat-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
        }

        .stat-icon {
            width: 50px;
            height: 50px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .stat-number {
            margin-top: 17px;
            font-size: 30px;
            font-weight: 800;
            line-height: 1;
        }

        .stat-card h6 {
            margin: 8px 0 4px;
            font-size: 15px;
            font-weight: 700;
        }

        .stat-card small {
            color: #77869c;
        }

        .blue {
            background: #e7f0ff;
            color: #0752b3;
        }

        .orange {
            background: #fff0df;
            color: #d86800;
        }

        .green {
            background: #e5f7eb;
            color: #16824b;
        }

        .purple {
            background: #f0e9ff;
            color: #7245ba;
        }

        .quick-card {
            margin-top: 18px;
            padding: 24px;
            border-radius: 18px;
            background: white;
            border: 1px solid #e4eaf2;
            box-shadow: 0 7px 22px rgba(18, 43, 85, .06);
        }

        .quick-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 15px;
            margin-top: 18px;
        }

        .quick-link {
            display: flex;
            align-items: center;
            gap: 13px;
            min-height: 88px;
            padding: 16px;
            border-radius: 14px;
            background: #f8fbff;
            border: 1px solid #e1e9f4;
            color: #0b1f44;
            text-decoration: none;
            transition: all .2s ease;
        }

            .quick-link:hover {
                color: #0752b3;
                border-color: #8eb9ef;
                background: #f2f7ff;
                transform: translateY(-2px);
            }

        .quick-link-icon {
            width: 48px;
            height: 48px;
            flex-shrink: 0;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e8f1ff;
            color: #0752b3;
            font-size: 23px;
        }

        .quick-link strong {
            display: block;
            font-size: 14px;
        }

        .quick-link small {
            display: block;
            margin-top: 3px;
            color: #77869c;
            font-weight: 400;
        }

        .footer {
            padding: 17px 30px;
            text-align: center;
            color: #718096;
            background: white;
            border-top: 1px solid #e4eaf2;
            font-size: 13px;
        }

        @@media (max-width: 1200px) {
            .stat-grid,
            .quick-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 850px) {
            .layout {
                display: block;
            }

            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
            }

            .main {
                width: 100%;
                margin-left: 0;
            }

            .topbar {
                padding: 14px 18px;
            }

            .content {
                padding: 22px 18px;
            }

            .menu-section {
                margin-top: 14px;
            }
        }

        @@media (max-width: 576px) {
            .topbar-title {
                display: none;
            }

            .welcome-banner {
                padding: 26px 22px;
            }

                .welcome-banner h2 {
                    font-size: 25px;
                }

            .stat-grid,
            .quick-grid {
                grid-template-columns: 1fr;
            }

            .section-title {
                align-items: flex-start;
                flex-direction: column;
                gap: 4px;
            }
        }
    </style>
</head>

<body>

    <div class="layout">

        <aside class="sidebar">

            <div class="brand">

                <img src="/images/inapa-logo.png"
                     alt="Logo INAPA" />

                <div>
                    <h2>INAPA</h2>

                    <small>
                        Instituto Nacional de Aguas<br />
                        Potables y Alcantarillados
                    </small>
                </div>

            </div>

            <div class="client-summary">

                <div class="client-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div>
                    <strong>@nombreUsuario</strong>
                    <span>Portal del cliente</span>
                </div>

            </div>

            <nav class="menu">

                <div class="menu-section">
                    Principal
                </div>

                <a asp-controller="Cliente"
                   asp-action="Index"
                   class="active">

                    <i class="bi bi-grid-fill"></i>
                    Inicio
                </a>

                <div class="menu-section">
                    Gestiones
                </div>

                <a asp-controller="Cliente"
                   asp-action="NuevaSolicitud">

                    <i class="bi bi-file-earmark-plus-fill"></i>
                    Solicitar servicio
                </a>

                <a asp-controller="Cliente"
                   asp-action="MisSolicitudes">

                    <i class="bi bi-list-check"></i>
                    Mis solicitudes
                </a>

                <a asp-controller="Cliente"
                   asp-action="MiContrato">

                    <i class="bi bi-file-earmark-text-fill"></i>
                    Mi contrato
                </a>

                <div class="menu-section">
                    Facturación
                </div>

                <a href="#">

                    <i class="bi bi-receipt-cutoff"></i>
                    Mis facturas
                </a>

                <a href="#">

                    <i class="bi bi-wallet2"></i>
                    Mis pagos
                </a>

                <div class="menu-section">
                    Atención
                </div>

                <a href="#">

                    <i class="bi bi-tools"></i>
                    Reportar avería
                </a>

                <a asp-controller="Reclamaciones"
                   asp-action="Index">

                    <i class="bi bi-chat-square-text-fill"></i>
                    Reclamaciones

                </a>

                <a href="#">

                    <i class="bi bi-bell-fill"></i>
                    Notificaciones
                </a>

                <div class="menu-section">
                    Cuenta
                </div>

                <a href="#">

                    <i class="bi bi-person-circle"></i>
                    Mi perfil
                </a>

                <a asp-controller="Acceso"
                   asp-action="CerrarSesion"
                   class="logout">

                    <i class="bi bi-box-arrow-left"></i>
                    Cerrar sesión
                </a>

            </nav>

        </aside>

        <main class="main">

            <header class="topbar">

                <div class="topbar-title">

                    <h5>Panel del cliente</h5>

                    <small>
                        Gestiona tus servicios de manera sencilla
                    </small>

                </div>

                <div class="topbar-user">

                    <div class="topbar-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <div>
                        <strong>@nombreUsuario</strong>
                        <small>Cliente</small>
                    </div>

                </div>

            </header>

            <section class="content">

                @if (TempData["Mensaje"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show"
                         role="alert">

                        <i class="bi bi-check-circle-fill me-1"></i>
                        @TempData["Mensaje"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>

                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show"
                         role="alert">

                        <i class="bi bi-exclamation-circle-fill me-1"></i>
                        @TempData["Error"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>

                    </div>
                }

                <div class="welcome-banner">

                    <div class="welcome-content">

                        <h2>
                            ¡Bienvenido, @nombreUsuario!
                        </h2>

                        <p>
                            Consulta tus solicitudes, contrato, facturas y demás
                            servicios relacionados con el suministro de agua potable.
                        </p>

                        <a asp-controller="Cliente"
                           asp-action="NuevaSolicitud"
                           class="welcome-action">

                            <i class="bi bi-plus-circle-fill"></i>
                            Solicitar servicio
                        </a>

                    </div>

                </div>

                <div class="section-title">

                    <h4>Resumen de tu cuenta</h4>

                    <span>
                        Información actual de tus gestiones
                    </span>

                </div>

                <div class="stat-grid">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div class="stat-icon blue">
                                <i class="bi bi-clipboard-check-fill"></i>
                            </div>

                        </div>

                        <div class="stat-number">
                            @(ViewBag.TotalSolicitudes ?? 0)
                        </div>

                        <h6>Mis solicitudes</h6>

                        <small>
                            Solicitudes registradas
                        </small>

                    </div>

                    <div class="stat-card">

                        <div class="stat-top">

                            <div class="stat-icon orange">
                                <i class="bi bi-receipt-cutoff"></i>
                            </div>

                        </div>

                        <div class="stat-number">
                            @(ViewBag.TotalFacturasPendientes ?? 0)
                        </div>

                        <h6>Facturas pendientes</h6>

                        <small>
                            Facturas por pagar
                        </small>

                    </div>

                    <div class="stat-card">

                        <div class="stat-top">

                            <div class="stat-icon green">
                                <i class="bi bi-wrench-adjustable-circle-fill"></i>
                            </div>

                        </div>

                        <div class="stat-number">
                            @(ViewBag.TotalAverias ?? 0)
                        </div>

                        <h6>Averías reportadas</h6>

                        <small>
                            Casos en seguimiento
                        </small>

                    </div>

                    <div class="stat-card">

                        <div class="stat-top">

                            <div class="stat-icon purple">
                                <i class="bi bi-chat-square-dots-fill"></i>
                            </div>

                        </div>

                        <div class="stat-number">
                            @(ViewBag.TotalReclamaciones ?? 0)
                        </div>

                        <h6>Reclamaciones</h6>

                        <small>
                            Reclamaciones registradas
                        </small>

                    </div>

                </div>

                <div class="quick-card">

                    <div class="section-title m-0">

                        <h4>Acciones rápidas</h4>

                        <span>
                            Accesos a las funciones principales
                        </span>

                    </div>

                    <div class="quick-grid">

                        <a asp-controller="Cliente"
                           asp-action="NuevaSolicitud"
                           class="quick-link">

                            <div class="quick-link-icon">
                                <i class="bi bi-file-earmark-plus-fill"></i>
                            </div>

                            <div>
                                <strong>Solicitar servicio</strong>

                                <small>
                                    Crear una solicitud
                                </small>
                            </div>

                        </a>

                        <a asp-controller="Cliente"
                           asp-action="MisSolicitudes"
                           class="quick-link">

                            <div class="quick-link-icon">
                                <i class="bi bi-list-check"></i>
                            </div>

                            <div>
                                <strong>Mis solicitudes</strong>

                                <small>
                                    Consultar estados
                                </small>
                            </div>

                        </a>

                        <a asp-controller="Cliente"
                           asp-action="MiContrato"
                           class="quick-link">

                            <div class="quick-link-icon">
                                <i class="bi bi-file-earmark-text-fill"></i>
                            </div>

                            <div>
                                <strong>Mi contrato</strong>

                                <small>
                                    Consultar contrato
                                </small>
                            </div>

                        </a>

                        <a href="#"
                           class="quick-link">

                            <div class="quick-link-icon">
                                <i class="bi bi-tools"></i>
                            </div>

                            <div>
                                <strong>Reportar avería</strong>

                                <small>
                                    Informar un problema
                                </small>
                            </div>

                        </a>

                    </div>

                </div>

            </section>

            <footer class="footer">
                © 2026 INAPA - Instituto Nacional de Aguas Potables y Alcantarillados
            </footer>

        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>
