@using InapaWeb.Models

@{
    Layout = null;
    var solicitud = ViewBag.Solicitud as SolicitudServicio;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Generar Contrato - INAPA</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet">

    <style>
        body {
            background: #f4f7fb;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        .main-card {
            max-width: 900px;
            margin: 35px auto;
            border: none;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, .09);
        }

        .card-header {
            border-radius: 18px 18px 0 0 !important;
            padding: 20px 24px;
        }

        .info-box {
            background: #f8f9fa;
            border: 1px solid #e1e5ea;
            border-radius: 12px;
            padding: 18px;
            height: 100%;
        }

        .tarifa-box {
            background: #eef6ff;
            border-left: 5px solid #0d6efd;
            border-radius: 10px;
            padding: 18px;
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="card main-card">

            <div class="card-header bg-primary text-white">
                <h3 class="mb-1">
                    <i class="bi bi-file-earmark-text-fill"></i>
                    Generar Contrato
                </h3>

                <small>
                    Creación del contrato de servicio para el cliente categorizado.
                </small>
            </div>

            <div class="card-body p-4">

                @if (solicitud == null)
                {
                    <div class="alert alert-danger">
                        No se encontró la solicitud.
                    </div>
                }
                else
                {
                    <div class="row g-3 mb-4">

                        <div class="col-md-6">
                            <div class="info-box">
                                <h5 class="mb-3">
                                    <i class="bi bi-person-fill"></i>
                                    Datos del cliente
                                </h5>

                                <p>
                                    <strong>Nombre:</strong>
                                    @solicitud.Cliente.Usuario.NombreUsuario
                                </p>

                                <p>
                                    <strong>Documento:</strong>
                                    @solicitud.Cliente.CedulaPasaporteRnc
                                </p>

                                <p>
                                    <strong>Teléfono:</strong>
                                    @solicitud.Cliente.Telefono
                                </p>

                                <p class="mb-0">
                                    <strong>Dirección:</strong>
                                    @solicitud.Cliente.Direccion,
                                    @solicitud.Cliente.Municipio,
                                    @solicitud.Cliente.Provincia
                                </p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-box">
                                <h5 class="mb-3">
                                    <i class="bi bi-clipboard-check-fill"></i>
                                    Datos de la solicitud
                                </h5>

                                <p>
                                    <strong>Número:</strong>
                                    #@solicitud.IdSolicitud
                                </p>

                                <p>
                                    <strong>Tipo:</strong>
                                    @solicitud.TipoSolicitud
                                </p>

                                <p>
                                    <strong>Fecha:</strong>
                                    @solicitud.FechaSolicitud.ToString("dd/MM/yyyy")
                                </p>

                                <p class="mb-0">
                                    <strong>Estado:</strong>
                                    <span class="badge bg-dark">
                                        @solicitud.Estado
                                    </span>
                                </p>
                            </div>
                        </div>

                    </div>

                    <div class="tarifa-box mb-4">
                        <h5>
                            <i class="bi bi-tags-fill"></i>
                            Categoría tarifaria asignada
                        </h5>

                        @if (solicitud.Cliente.Tarifa == null)
                        {
                            <p class="text-danger mb-0">
                                El cliente no tiene una tarifa asignada.
                            </p>
                        }
                        else
                        {
                            <p class="mb-1">
                                <strong>Categoría:</strong>
                                @solicitud.Cliente.Tarifa.Descripcion
                            </p>

                            <p class="mb-0">
                                <strong>Monto:</strong>
                                RD$ @solicitud.Cliente.Tarifa.Monto.ToString("N2")
                            </p>
                        }
                    </div>

                    <form asp-action="GenerarContrato"
                          method="post">

                        <input type="hidden"
                               name="idSolicitud"
                               value="@solicitud.IdSolicitud" />

                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                Fecha de inicio del contrato
                            </label>

                            <input type="date"
                                   name="fechaInicio"
                                   class="form-control"
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                   required />
                        </div>

                        <div class="alert alert-info">
                            <i class="bi bi-info-circle-fill"></i>
                            El contrato se generará con estado
                            <strong>Pendiente</strong> hasta ser aprobado por el administrador.
                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-success"
                                    onclick="return confirm('¿Deseas generar este contrato?');">

                                <i class="bi bi-file-earmark-check-fill"></i>
                                Generar contrato
                            </button>

                            <a asp-action="Solicitudes"
                               class="btn btn-secondary">

                                <i class="bi bi-arrow-left"></i>
                                Volver
                            </a>

                        </div>

                    </form>
                }

            </div>
        </div>

    </div>

</body>
</html>
