@model InapaWeb.Models.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Editar Usuario</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background: #f4f7fb;
            font-family: 'Segoe UI';
        }

        .card {
            max-width: 850px;
            margin: 40px auto;
            border: none;
            border-radius: 18px;
            box-shadow: 0 8px 20px rgba(0,0,0,.08);
        }

        .card-header {
            background: #0d6efd;
            color: white;
            padding: 18px;
            font-size: 22px;
            font-weight: bold;
            border-radius: 18px 18px 0 0;
        }

        .btn-save {
            background: #0d6efd;
            color: white;
        }

            .btn-save:hover {
                background: #0b5ed7;
                color: white;
            }
    </style>
</head>

<body>

    <div class="card">

        <div class="card-header">
            <i class="bi bi-pencil-square"></i>
            Editar Usuario
        </div>

        <div class="card-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form asp-action="EditarUsuario" method="post">

                <input type="hidden" asp-for="IdUsuario" />

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label>Nombre Completo</label>
                        <input asp-for="NombreUsuario" class="form-control" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Correo Electrónico</label>
                        <input asp-for="Correo" class="form-control" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Nueva Contraseña</label>
                        <input asp-for="Contrasena"
                               type="password"
                               class="form-control"
                               placeholder="Dejar vacío si no desea cambiarla" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Rol</label>
                        <select asp-for="Rol" class="form-select" required>
                            <option value="">Seleccione...</option>
                            <option>Administrador</option>
                            <option>Cliente</option>
                            <option>Técnico</option>
                            <option>Cajero</option>
                            <option>Supervisor</option>
                            <option>AtencionCliente</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-4">
                        <label>Estado</label>
                        <select asp-for="Estado" class="form-select" required>
                            <option>Activo</option>
                            <option>Pendiente</option>
                            <option>Inactivo</option>
                        </select>
                    </div>

                </div>

                <hr />

                <button type="submit" class="btn btn-save">
                    <i class="bi bi-check-circle-fill"></i>
                    Guardar Cambios
                </button>

                <a asp-action="Usuarios" class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>
    </div>

</body>
</html>