@model IEnumerable<InapaWeb.Models.Reclamacion>

@{
    ViewData["Title"] = "Reclamación Individual";
}


<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header text-white"
             style="background:#0752b3">

            <h3 class="mb-0">
                👤 Reclamación Individual
            </h3>

        </div>


        <div class="card-body">

            <p class="text-muted">
                Gestión de reclamaciones realizadas por un cliente específico.
            </p>


            <h5 class="mt-4">
                Reclamaciones Recibidas
            </h5>

            <p>
                Ver reclamaciones enviadas por los clientes.
            </p>

            <a asp-controller="Admin"
               asp-action="Individual"
               class="btn btn-primary">

                Ver reclamaciones

            </a>

            <hr />
            <h5 class="mt-4">
                Listado de Reclamaciones
            </h5>


            <form method="get" asp-action="Individual">

                <div class="input-group mt-3 mb-3">

                    <input type="text"
                           name="buscar"
                           value="@ViewBag.Buscar"
                           class="form-control"
                           placeholder="Buscar reclamación..." />

                    <button class="btn btn-primary"
                            type="submit">

                        🔍 Buscar

                    </button>

                </div>

            </form>


            <hr />


            <div class="table-responsive mt-3">

                <table class="table table-bordered table-hover">

               <thead class="table-primary">

<tr>

    <th>
        ID
    </th>

    <th>
        Cliente
    </th>

    <th>
        Estado
    </th>

    <th>
        Situación
    </th>

    <th>
        Acción
    </th>

</tr>

</thead>
                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>@item.IdReclamacion</td>

                                    <td>@item.Cliente.Usuario.NombreUsuario</td>

                                    <td>@item.Estado</td>

                                    <td>@item.Descripcion</td>

                                    <td>

                                        <a asp-action="DetalleReclamacion"
                                           asp-route-id="@item.IdReclamacion"
                                           class="btn btn-info btn-sm">

                                            Ver

                                        </a>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="5" class="text-center">

                                    No hay reclamaciones registradas.

                                </td>

                            </tr>
                        }

                    </tbody>

        </table>

    </div>
</div>