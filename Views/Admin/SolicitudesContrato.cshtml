@model List<InapaWeb.Models.SolicitudContrato>

@{
    Layout = null;
    ViewData["Title"] = "Solicitudes de Contrato";
    var buscar = ViewBag.Buscar as string;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Solicitudes de Contrato - INAPA</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f3f6fb;
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #10213f;
        }

        .page-shell {
            min-height: 100vh;
            padding: 28px;
        }

        .top-header {
            background: linear-gradient(135deg, #06469b, #002d69);
            border-radius: 20px;
            color: white;
            padding: 26px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            box-shadow: 0 14px 34px rgba(2, 48, 112, .22);
            margin-bottom: 24px;
        }

        .header-title {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .header-icon {
            width: 62px;
            height: 62px;
            border-radius: 18px;
            background: rgba(255, 255, 255, .14);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
        }

        .top-header h2 {
            margin: 0 0 5px;
            font-size: 28px;
            font-weight: 800;
        }

        .top-header p {
            margin: 0;
            opacity: .9;
        }

        .panel-button {
            background: white;
            color: #06469b;
            border: none;
            border-radius: 12px;
            padding: 11px 18px;
            text-decoration: none;
            font-weight: 700;
            white-space: nowrap;
        }

            .panel-button:hover {
                background: #eef5ff;
                color: #06469b;
            }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 24px;
        }

        .summary-card {
            background: white;
            border: 1px solid #e3e9f2;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 7px 22px rgba(16, 33, 63, .06);
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .summary-icon {
            width: 54px;
            height: 54px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
        }

        .icon-pending {
            background: #fff3cd;
            color: #b77900;
        }

        .icon-approved {
            background: #d1e7dd;
            color: #146c43;
        }

        .icon-rejected {
            background: #f8d7da;
            color: #b02a37;
        }

        .summary-card small {
            color: #718096;
            display: block;
        }

        .summary-card strong {
            font-size: 26px;
            color: #10213f;
        }

        .main-card {
            border: none;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(16, 33, 63, .08);
            overflow: hidden;
        }

        .toolbar {
            background: white;
            padding: 20px 22px;
            border-bottom: 1px solid #e8edf4;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .toolbar-title h5 {
            margin: 0 0 4px;
            font-weight: 800;
        }

        .toolbar-title small {
            color: #718096;
        }

        .search-box {
            width: 100%;
            max-width: 520px;
        }

            .search-box .form-control {
                border-radius: 12px 0 0 12px;
                border-color: #d8e0eb;
            }

            .search-box .btn {
                border-radius: 0;
            }

                .search-box .btn:last-child {
                    border-radius: 0 12px 12px 0;
                }

        .table-wrap {
            overflow-x: auto;
        }

        .table {
            margin: 0;
        }

            .table thead th {
                background: #eef4fb;
                color: #28415f;
                font-size: 13px;
                text-transform: uppercase;
                letter-spacing: .04em;
                border-bottom: 1px solid #dce5f0;
                padding: 15px 14px;
                white-space: nowrap;
            }

            .table tbody td {
                padding: 16px 14px;
                vertical-align: middle;
                border-color: #edf1f6;
            }

        .request-code {
            font-weight: 800;
            color: #06469b;
        }

        .client-name {
            font-weight: 700;
        }

        .client-email {
            color: #7a8798;
            font-size: 13px;
        }

        .address-cell {
            min-width: 230px;
            max-width: 320px;
            white-space: normal;
        }

        .observation-cell {
            min-width: 220px;
            max-width: 330px;
            white-space: normal;
            color: #52627a;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 11px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
        }

        .status-pending {
            background: #fff3cd;
            color: #7a5900;
        }

        .status-approved {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-rejected {
            background: #f8d7da;
            color: #842029;
        }

        .status-generated {
            background: #cff4fc;
            color: #055160;
        }

        .status-finalized {
            background: #e2e3e5;
            color: #41464b;
        }

        .action-group {
            display: flex;
            gap: 7px;
            flex-wrap: wrap;
            min-width: 205px;
        }

            .action-group .btn {
                border-radius: 9px;
                font-weight: 600;
            }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #718096;
        }

            .empty-state i {
                font-size: 52px;
                color: #9fb3c8;
                margin-bottom: 14px;
            }

            .empty-state h5 {
                color: #28415f;
                font-weight: 800;
            }

        .alert {
            border-radius: 12px;
        }

        @@media (max-width: 992px) {
            .summary-grid {
                grid-template-columns: 1fr;
            }

            .top-header {
                align-items: flex-start;
                flex-direction: column;
            }
        }

        @@media (max-width: 576px) {
            .page-shell {
                padding: 16px;
            }

            .top-header {
                padding: 20px;
            }

            .header-icon {
                width: 52px;
                height: 52px;
            }

            .top-header h2 {
                font-size: 23px;
            }

            .toolbar {
                padding: 16px;
            }
        }
    </style>
</head>

<body>

    <div class="page-shell">

        <header class="top-header">

            <div class="header-title">

                <div class="header-icon">
                    <i class="bi bi-file-earmark-person-fill"></i>
                </div>

                <div>
                    <h2>Solicitudes de Contrato</h2>

                    <p>
                        Revisa, aprueba o rechaza las solicitudes enviadas por los clientes.
                    </p>
                </div>

            </div>

            <a asp-controller="Admin"
               asp-action="Index"
               class="panel-button">

                <i class="bi bi-grid-fill"></i>
                Panel principal
            </a>

        </header>

        @{
            int pendientes = Model?.Count(x => x.Estado == "Pendiente") ?? 0;
            int aprobadas = Model?.Count(x => x.Estado == "Aprobada") ?? 0;
            int rechazadas = Model?.Count(x => x.Estado == "Rechazada") ?? 0;
        }

        <section class="summary-grid">

            <div class="summary-card">

                <div class="summary-icon icon-pending">
                    <i class="bi bi-hourglass-split"></i>
                </div>

                <div>
                    <small>Pendientes de revisión</small>
                    <strong>@pendientes</strong>
                </div>

            </div>

            <div class="summary-card">

                <div class="summary-icon icon-approved">
                    <i class="bi bi-check-circle-fill"></i>
                </div>

                <div>
                    <small>Solicitudes aprobadas</small>
                    <strong>@aprobadas</strong>
                </div>

            </div>

            <div class="summary-card">

                <div class="summary-icon icon-rejected">
                    <i class="bi bi-x-circle-fill"></i>
                </div>

                <div>
                    <small>Solicitudes rechazadas</small>
                    <strong>@rechazadas</strong>
                </div>

            </div>

        </section>

        @if (TempData["MensajeSolicitudContrato"] != null)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle-fill"></i>
                @TempData["MensajeSolicitudContrato"]
            </div>
        }

        @if (TempData["ErrorSolicitudContrato"] != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-circle-fill"></i>
                @TempData["ErrorSolicitudContrato"]
            </div>
        }

        <div class="card main-card">

            <div class="toolbar">

                <div class="toolbar-title">
                    <h5>Listado de solicitudes</h5>

                    <small>
                        Información actualizada desde la base de datos.
                    </small>
                </div>

                <form asp-controller="Admin"
                      asp-action="SolicitudesContrato"
                      method="get"
                      class="input-group search-box">

                    <input type="text"
                           name="buscar"
                           value="@buscar"
                           class="form-control"
                           placeholder="Buscar cliente, correo, servicio, dirección o estado..." />

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-search"></i>
                    </button>

                    <a asp-controller="Admin"
                       asp-action="SolicitudesContrato"
                       class="btn btn-outline-secondary">

                        Limpiar
                    </a>

                </form>

            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="empty-state">

                    <i class="bi bi-inbox-fill"></i>

                    <h5>No hay solicitudes de contrato</h5>

                    <p class="mb-0">
                        Las solicitudes enviadas por los clientes aparecerán aquí.
                    </p>

                </div>
            }
            else
            {
                <div class="table-wrap">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Cliente</th>
                                <th>Servicio</th>
                                <th>Dirección</th>
                                <th>Fecha</th>
                                <th>Observación</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        <span class="request-code">
                                            SC-@item.IdSolicitudContrato.ToString("00000")
                                        </span>
                                    </td>

                                    <td>
                                        <div class="client-name">
                                            @(item.Cliente?.Usuario?.NombreUsuario ?? "No disponible")
                                        </div>

                                        <div class="client-email">
                                            @(item.Cliente?.Usuario?.Correo ?? "Sin correo")
                                        </div>
                                    </td>

                                    <td>
                                        <strong>@item.TipoServicio</strong>
                                    </td>

                                    <td class="address-cell">
                                        @item.DireccionServicio
                                    </td>

                                    <td>
                                        @item.FechaSolicitud.ToString("dd/MM/yyyy")
                                        <br />

                                        <small class="text-muted">
                                            @item.FechaSolicitud.ToString("hh:mm tt")
                                        </small>
                                    </td>

                                    <td class="observation-cell">
                                        @(string.IsNullOrWhiteSpace(item.ObservacionCliente)
                                                                        ? "Sin observaciones"
                                                                        : item.ObservacionCliente)
                            </td>

                                    <td>
                                @if (item.Estado == "Pendiente")
                                        {
                                            <span class="status-badge status-pending">
                                                <i class="bi bi-hourglass-split"></i>
                                                Pendiente
                                            </span>
                                        }
                                        else if (item.Estado == "Aprobada")
                                        {
                                            <span class="status-badge status-approved">
                                                <i class="bi bi-check-circle-fill"></i>
                                                Aprobada
                                            </span>
                                        }
                                        else if (item.Estado == "Rechazada")
                                        {
                                            <span class="status-badge status-rejected">
                                                <i class="bi bi-x-circle-fill"></i>
                                                Rechazada
                                            </span>
                                        }
                                        else if (item.Estado == "Contrato Generado")
                                        {
                                            <span class="status-badge status-generated">
                                                <i class="bi bi-file-earmark-check-fill"></i>
                                                Contrato generado
                                            </span>
                                        }
                                        else if (item.Estado == "Finalizada")
                                        {
                                            <span class="status-badge status-finalized">
                                                <i class="bi bi-check2-all"></i>
                                                Finalizada
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-finalized">
                                                @item.Estado
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="action-group">

                                            @if (item.Estado == "Pendiente")
                                            {
                                                <a asp-controller="Admin"
                                                   asp-action="AprobarSolicitudContrato"
                                                   asp-route-id="@item.IdSolicitudContrato"
                                                   class="btn btn-success btn-sm"
                                                   onclick="return confirm('¿Deseas aprobar esta solicitud de contrato?');">

                                                    <i class="bi bi-check-circle"></i>
                                                    Aprobar
                                                </a>

                                                <a asp-controller="Admin"
                                                   asp-action="RechazarSolicitudContrato"
                                                   asp-route-id="@item.IdSolicitudContrato"
                                                   class="btn btn-danger btn-sm"
                                                   onclick="return confirm('¿Seguro que deseas rechazar esta solicitud de contrato?');">

                                                    <i class="bi bi-x-circle"></i>
                                                    Rechazar
                                                </a>
                                            }
                                            else if (item.Estado == "Aprobada")
                                            {
                                                <a asp-controller="Admin"
                                                   asp-action="Solicitudes"
                                                   class="btn btn-primary btn-sm">

                                                    <i class="bi bi-person-gear"></i>
                                                    Ir a levantamiento
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">
                                                    Sin acciones pendientes
                                                </span>
                                            }

                                        </div>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</body>
</html>
