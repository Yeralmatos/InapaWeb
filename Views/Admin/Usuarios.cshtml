@model List<InapaWeb.Models.Usuario>

@{
    Layout = null;
    ViewData["Title"] = "Gestión de Usuarios";
    var buscar = ViewBag.Buscar as string;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Gestión de Usuarios - INAPA</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f3f6fb;
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #10213f;
        }

        .page-shell {
            min-height: 100vh;
            padding: 28px;
        }

        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            padding: 26px 30px;
            margin-bottom: 24px;
            border-radius: 20px;
            color: white;
            background: linear-gradient(135deg, #06469b, #002d69);
            box-shadow: 0 14px 34px rgba(2, 48, 112, .22);
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .header-icon {
            width: 62px;
            height: 62px;
            border-radius: 18px;
            background: rgba(255, 255, 255, .14);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            flex-shrink: 0;
        }

        .top-header h2 {
            margin: 0 0 5px;
            font-size: 28px;
            font-weight: 800;
        }

        .top-header p {
            margin: 0;
            opacity: .9;
        }

        .header-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

            .header-actions .btn {
                border-radius: 12px;
                font-weight: 700;
                padding: 11px 17px;
            }

        .btn-light-custom {
            background: white;
            color: #06469b;
            border: none;
        }

            .btn-light-custom:hover {
                background: #edf5ff;
                color: #06469b;
            }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 24px;
        }

        .summary-card {
            background: white;
            border: 1px solid #e3e9f2;
            border-radius: 16px;
            padding: 19px;
            box-shadow: 0 7px 22px rgba(16, 33, 63, .06);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .summary-icon {
            width: 54px;
            height: 54px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            flex-shrink: 0;
        }

        .icon-total {
            background: #e8f1ff;
            color: #0d6efd;
        }

        .icon-active {
            background: #d1e7dd;
            color: #146c43;
        }

        .icon-pending {
            background: #fff3cd;
            color: #b77900;
        }

        .icon-inactive {
            background: #e2e3e5;
            color: #495057;
        }

        .summary-card small {
            display: block;
            color: #718096;
        }

        .summary-card strong {
            display: block;
            font-size: 26px;
            color: #10213f;
        }

        .main-card {
            background: white;
            border: none;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(16, 33, 63, .08);
            overflow: hidden;
        }

        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
            padding: 20px 22px;
            border-bottom: 1px solid #e8edf4;
        }

        .toolbar-title h5 {
            margin: 0 0 4px;
            font-weight: 800;
        }

        .toolbar-title small {
            color: #718096;
        }

        .search-box {
            width: 100%;
            max-width: 560px;
        }

            .search-box .form-control {
                border-radius: 12px 0 0 12px;
            }

            .search-box .btn {
                border-radius: 0;
            }

                .search-box .btn:last-child {
                    border-radius: 0 12px 12px 0;
                }

        .table-wrap {
            overflow-x: auto;
        }

        .table {
            margin: 0;
        }

            .table thead th {
                padding: 15px 14px;
                background: #eef4fb;
                color: #28415f;
                border-bottom: 1px solid #dce5f0;
                font-size: 13px;
                text-transform: uppercase;
                letter-spacing: .04em;
                white-space: nowrap;
            }

            .table tbody td {
                padding: 16px 14px;
                vertical-align: middle;
                border-color: #edf1f6;
            }

        .user-id {
            color: #06469b;
            font-weight: 800;
        }

        .user-name {
            font-weight: 700;
            color: #10213f;
        }

        .user-email {
            color: #718096;
            font-size: 13px;
        }

        .role-badge,
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 11px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
            white-space: nowrap;
        }

        .role-badge {
            background: #e8f1ff;
            color: #06469b;
        }

        .status-active {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-pending {
            background: #fff3cd;
            color: #664d03;
        }

        .status-rejected {
            background: #f8d7da;
            color: #842029;
        }

        .status-inactive {
            background: #e2e3e5;
            color: #41464b;
        }

        .action-group {
            display: flex;
            gap: 7px;
            flex-wrap: wrap;
            min-width: 390px;
        }

            .action-group .btn {
                border-radius: 9px;
                font-weight: 600;
            }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #718096;
        }

            .empty-state i {
                display: block;
                margin-bottom: 14px;
                color: #9fb3c8;
                font-size: 52px;
            }

            .empty-state h5 {
                color: #28415f;
                font-weight: 800;
            }

        .alert {
            border-radius: 12px;
        }

        @@media (max-width: 1100px) {
            .summary-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 768px) {
            .page-shell {
                padding: 16px;
            }

            .top-header {
                align-items: flex-start;
                flex-direction: column;
                padding: 20px;
            }

            .header-actions {
                width: 100%;
            }

                .header-actions .btn {
                    flex: 1;
                }

            .summary-grid {
                grid-template-columns: 1fr;
            }

            .toolbar {
                padding: 16px;
            }

            .search-box {
                max-width: none;
            }
        }
    </style>
</head>

<body>

    @{
        int totalUsuarios = Model?.Count ?? 0;
        int totalActivos = Model?.Count(u => u.Estado == "Activo") ?? 0;
        int totalPendientes = Model?.Count(u => u.Estado == "Pendiente") ?? 0;
        int totalInactivos = Model?.Count(u =>
        u.Estado == "Inactivo" ||
        u.Estado == "Rechazado") ?? 0;
    }

    <div class="page-shell">

        <header class="top-header">

            <div class="header-left">

                <div class="header-icon">
                    <i class="bi bi-people-fill"></i>
                </div>

                <div>
                    <h2>Gestión de Usuarios</h2>

                    <p>
                        Administra las cuentas, roles y accesos del sistema.
                    </p>
                </div>

            </div>

            <div class="header-actions">

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="btn btn-light-custom">

                    <i class="bi bi-grid-fill"></i>
                    Panel principal
                </a>

                <a asp-controller="Admin"
                   asp-action="CrearUsuario"
                   class="btn btn-success">

                    <i class="bi bi-person-plus-fill"></i>
                    Nuevo usuario
                </a>

            </div>

        </header>

        <section class="summary-grid">

            <div class="summary-card">

                <div class="summary-icon icon-total">
                    <i class="bi bi-people-fill"></i>
                </div>

                <div>
                    <small>Total de usuarios</small>
                    <strong>@totalUsuarios</strong>
                </div>

            </div>

            <div class="summary-card">

                <div class="summary-icon icon-active">
                    <i class="bi bi-person-check-fill"></i>
                </div>

                <div>
                    <small>Usuarios activos</small>
                    <strong>@totalActivos</strong>
                </div>

            </div>

            <div class="summary-card">

                <div class="summary-icon icon-pending">
                    <i class="bi bi-hourglass-split"></i>
                </div>

                <div>
                    <small>Pendientes de aprobación</small>
                    <strong>@totalPendientes</strong>
                </div>

            </div>

            <div class="summary-card">

                <div class="summary-icon icon-inactive">
                    <i class="bi bi-person-dash-fill"></i>
                </div>

                <div>
                    <small>Inactivos o rechazados</small>
                    <strong>@totalInactivos</strong>
                </div>

            </div>

        </section>

        @if (TempData["MensajeUsuario"] != null)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle-fill"></i>
                @TempData["MensajeUsuario"]
            </div>
        }

        @if (TempData["ErrorUsuario"] != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-circle-fill"></i>
                @TempData["ErrorUsuario"]
            </div>
        }

        <div class="main-card">

            <div class="toolbar">

                <div class="toolbar-title">
                    <h5>Listado de usuarios</h5>

                    <small>
                        Información actualizada desde la base de datos.
                    </small>
                </div>

                <form asp-controller="Admin"
                      asp-action="Usuarios"
                      method="get"
                      class="input-group search-box">

                    <input type="text"
                           name="buscar"
                           value="@buscar"
                           class="form-control"
                           placeholder="Buscar por nombre, correo, rol o estado..." />

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-search"></i>
                    </button>

                    <a asp-controller="Admin"
                       asp-action="Usuarios"
                       class="btn btn-outline-secondary">

                        Limpiar
                    </a>

                </form>

            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="empty-state">

                    <i class="bi bi-people"></i>

                    <h5>No hay usuarios registrados</h5>

                    <p class="mb-3">
                        Los usuarios registrados aparecerán en esta sección.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="CrearUsuario"
                       class="btn btn-primary">

                        <i class="bi bi-person-plus-fill"></i>
                        Crear primer usuario
                    </a>

                </div>
            }
            else
            {
                <div class="table-wrap">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Usuario</th>
                                <th>Rol</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        <span class="user-id">
                                            #@item.IdUsuario
                                        </span>
                                    </td>

                                    <td>
                                        <div class="user-name">
                                            @item.NombreUsuario
                                        </div>

                                        <div class="user-email">
                                            @item.Correo
                                        </div>
                                    </td>

                                    <td>
                                        <span class="role-badge">
                                            <i class="bi bi-shield-person"></i>
                                            @item.Rol
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.Estado == "Activo")
                                        {
                                            <span class="status-badge status-active">
                                                <i class="bi bi-check-circle-fill"></i>
                                                Activo
                                            </span>
                                        }
                                        else if (item.Estado == "Pendiente")
                                        {
                                            <span class="status-badge status-pending">
                                                <i class="bi bi-hourglass-split"></i>
                                                Pendiente
                                            </span>
                                        }
                                        else if (item.Estado == "Rechazado")
                                        {
                                            <span class="status-badge status-rejected">
                                                <i class="bi bi-x-circle-fill"></i>
                                                Rechazado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-inactive">
                                                <i class="bi bi-person-dash-fill"></i>
                                                @item.Estado
                                            </span>
                                        }
                                    </td>

                                    <td>

                                        <div class="action-group">

                                            @if (item.Estado == "Pendiente")
                                            {
                                                <a asp-controller="Admin"
                                                   asp-action="AprobarUsuario"
                                                   asp-route-id="@item.IdUsuario"
                                                   class="btn btn-success btn-sm"
                                                   onclick="return confirm('¿Deseas aprobar este usuario?');">

                                                    <i class="bi bi-check-circle"></i>
                                                    Aprobar
                                                </a>

                                                <a asp-controller="Admin"
                                                   asp-action="RechazarUsuario"
                                                   asp-route-id="@item.IdUsuario"
                                                   class="btn btn-outline-danger btn-sm"
                                                   onclick="return confirm('¿Seguro que deseas rechazar este usuario?');">

                                                    <i class="bi bi-x-circle"></i>
                                                    Rechazar
                                                </a>
                                            }

                                            <a asp-controller="Admin"
                                               asp-action="DetalleUsuario"
                                               asp-route-id="@item.IdUsuario"
                                               class="btn btn-info btn-sm text-white">

                                                <i class="bi bi-eye-fill"></i>
                                                Ver
                                            </a>

                                            <a asp-controller="Admin"
                                               asp-action="EditarUsuario"
                                               asp-route-id="@item.IdUsuario"
                                               class="btn btn-warning btn-sm">

                                                <i class="bi bi-pencil-square"></i>
                                                Editar
                                            </a>

                                            <a asp-controller="Admin"
                                               asp-action="CambiarEstado"
                                               asp-route-id="@item.IdUsuario"
                                               class="btn btn-secondary btn-sm"
                                               onclick="return confirm('¿Deseas cambiar el estado de este usuario?');">

                                                <i class="bi bi-arrow-repeat"></i>
                                                Estado
                                            </a>

                                            <a asp-controller="Admin"
                                               asp-action="EliminarUsuario"
                                               asp-route-id="@item.IdUsuario"
                                               class="btn btn-danger btn-sm"
                                               onclick="return confirm('¿Seguro que deseas eliminar este usuario?');">

                                                <i class="bi bi-trash-fill"></i>
                                                Eliminar
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</body>
</html>

