@model InapaWeb.Models.AsignacionTecnico

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>

    <meta charset="utf-8" />

    <title>Resultado del Levantamiento</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

</head>

<body class="bg-light">

    <div class="container mt-4">

        <div class="card shadow">

            <div class="card-header bg-primary text-white">

                <h3>

                    <i class="bi bi-clipboard-check"></i>

                    Resultado del Levantamiento

                </h3>

            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6">

                        <p><strong>Cliente:</strong> @Model.SolicitudServicio.Cliente.Usuario.NombreUsuario</p>

                        <p><strong>Técnico:</strong> @Model.Tecnico.NombreUsuario</p>

                        <p><strong>Solicitud:</strong> #@Model.IdSolicitud</p>

                    </div>

                    <div class="col-md-6">

                        <p><strong>Tipo de trabajo:</strong> @Model.TipoTrabajo</p>

                        <p><strong>Fecha asignación:</strong> @Model.FechaAsignacion.ToString("dd/MM/yyyy")</p>

                        <p><strong>Fecha finalización:</strong> @(Model.FechaFinalizacion?.ToString("dd/MM/yyyy HH:mm") ?? "Pendiente")</p>

                    </div>

                </div>

                <hr />

                <div class="mb-3">

                    <label class="form-label">

                        Descripción de la solicitud

                    </label>

                    <textarea class="form-control" rows="4" readonly>@Model.SolicitudServicio.Descripcion</textarea>

                </div>

                <div class="mb-3">

                    <label class="form-label">

                        Observaciones del Administrador

                    </label>

                    <textarea class="form-control" rows="3" readonly>@Model.Observacion</textarea>

                </div>

                <div class="mb-4">

                    <label class="form-label">

                        Resultado del Levantamiento

                    </label>

                    <textarea class="form-control" rows="8" readonly>@Model.Resultado</textarea>

                </div>

                <div class="d-flex gap-2">

                    <a asp-action="CategorizarCliente"
                       asp-route-id="@Model.IdSolicitud"
                       class="btn btn-success">

                        <i class="bi bi-tags"></i>

                        Categorizar Cliente

                    </a>

                    <a asp-action="Solicitudes"
                       class="btn btn-secondary">

                        Volver

                    </a>

                </div>

            </div>

        </div>

    </div>

</body>
</html>
