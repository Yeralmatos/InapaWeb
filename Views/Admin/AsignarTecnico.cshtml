@using InapaWeb.Models

@{
    Layout = null;

    var solicitud = ViewBag.Solicitud as SolicitudServicio;
    var tecnicos = ViewBag.Tecnicos as List<Usuario>;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Asignar Técnico</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
</head>

<body class="bg-light">

    <div class="container mt-4">

        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h3>
                    <i class="bi bi-person-gear"></i>
                    Asignar Técnico
                </h3>
            </div>

            <div class="card-body">

                <h5>Solicitud #@solicitud.IdSolicitud</h5>

                <p><strong>Cliente:</strong> @solicitud.Cliente.Usuario.NombreUsuario</p>
                <p><strong>Tipo de solicitud:</strong> @solicitud.TipoSolicitud</p>
                <p><strong>Descripción:</strong> @solicitud.Descripcion</p>

                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    Esta solicitud generará automáticamente un <strong>levantamiento técnico</strong>.
                </div>

                <hr />

                <form asp-action="AsignarTecnico" method="post">

                    <input type="hidden"
                           name="idSolicitud"
                           value="@solicitud.IdSolicitud" />

                    <div class="mb-3">
                        <label class="form-label">Seleccione el técnico</label>

                        <select name="idTecnico" class="form-select" required>
                            <option value="">Seleccione...</option>

                            @foreach (var tecnico in tecnicos)
                            {
                                <option value="@tecnico.IdUsuario">
                                    @tecnico.NombreUsuario
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label>Observación</label>

                        <textarea name="observacion"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Escriba una observación para el técnico..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i>
                        Asignar Técnico
                    </button>

                    <a href="/Admin/Solicitudes" class="btn btn-secondary">
                        Cancelar
                    </a>

                </form>

            </div>
        </div>

    </div>

</body>
</html>