@{
    ViewData["Title"] = "Reclamación Vivienda";
}

<h1>Reclamación para una Vivienda</h1>

<form>

    <div>
        <label>Nombre del propietario o residente:</label>
        <input type="text" class="form-control" />
    </div>

    <br />

    <div>
        <label>Dirección de la vivienda:</label>
        <input type="text" class="form-control" />
    </div>

    <br />

    <div>
        <label>Sector:</label>
        <input type="text" class="form-control" />
    </div>

    <br />

    <div>
        <label>Descripción del problema:</label>
        <textarea class="form-control"></textarea>
    </div>

    <br />

    <div>
        <label>Evidencia (imagen o documento):</label>
        <input type="file" class="form-control" />
    </div>

    <br />

    <button type="submit" class="btn btn-primary">
        Enviar Reclamación
    </button>

</form>