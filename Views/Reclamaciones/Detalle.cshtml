@{
    ViewData["Title"] = "Detalle de Reclamación";
}

<h1>Detalle y Evidencias de la Reclamación</h1>

<div>

    <h3>Información de la reclamación</h3>

    <p>
        <strong>ID Reclamación:</strong> 1
    </p>

    <p>
        <strong>Cliente:</strong> Nombre del ciudadano
    </p>

    <p>
        <strong>Descripción:</strong>
        Problema reportado por el ciudadano.
    </p>

    <p>
        <strong>Estado:</strong>
        Pendiente
    </p>

</div>

<hr />

<h3>Evidencias</h3>

<div>
    <label>Agregar evidencia:</label>
    <input type="file" class="form-control" />
</div>

<br />

<button class="btn btn-primary">
    Guardar Evidencia
</button>