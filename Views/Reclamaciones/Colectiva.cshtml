@model InapaWeb.Models.Reclamacion

@{
    ViewData["Title"] = "Reclamación Colectiva";
}

<div class="container mt-4">

    <h2>Reclamación Colectiva</h2>
    <hr />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    <form asp-action="Colectiva" method="post">

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label">
                Descripción de la reclamación colectiva
            </label>

            <textarea asp-for="Descripcion"
                      class="form-control"
                      rows="6"
                      placeholder="Describa la situación que afecta al sector o comunidad..."></textarea>

            <span asp-validation-for="Descripcion"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">
            Registrar Reclamación
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}