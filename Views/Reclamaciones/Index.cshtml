<div class="container my-4">
    <!-- Encabezado Principal -->
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h3 class="mb-0 fs-4 fw-bold">Módulo de Reclamaciones</h3>
        </div>
        <div class="card-body">
            <p class="text-muted mb-0">Gestione sus reclamaciones individuales y colectivas, consulte estados y realice seguimiento de sus casos.</p>
        </div>
    </div>

    <!-- Grid de Opciones / Tarjetas -->
    <div class="row g-4">

        <!-- Reclamación Individual -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border">
                <div class="card-body text-center d-flex flex-column">
                    <h5 class="card-title fw-bold">Reclamación Individual</h5>
                    <p class="card-text text-muted flex-grow-1">Reclamos realizados por un ciudadano.</p>
                    <div class="d-grid gap-2 mt-3">
                        <a asp-controller="Reclamaciones"
   asp-action="Individual"
   class="btn btn-primary">
    Registrar
</a>
                        <a asp-controller="Home"
   asp-action="Index"
   class="btn btn-outline-secondary">
    Volver a Módulos
</a>
                    </div>
                </div>
            </div>
        </div>

    <!-- Reclamación Colectiva -->
<div class="col-md-6 col-lg-4">
    <div class="card h-100 shadow-sm border">
        <div class="card-body text-center d-flex flex-column">
            <h5 class="card-title fw-bold">
                Reclamación Colectiva
            </h5>

            <p class="card-text text-muted flex-grow-1">
                Reportar problemas que afectan un barrio o sector.
            </p>

            <div class="d-grid gap-2 mt-3">

                <a asp-controller="Reclamaciones"
                   asp-action="Colectiva"
                   class="btn btn-success">
                    Registrar
                </a>

                <a asp-controller="Cliente"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Volver a Módulos
                </a>

            </div>
        </div>
    </div>
</div>
        <!-- Reclamación Virtual -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border">
                <div class="card-body text-center d-flex flex-column">
                    <h5 class="card-title fw-bold">Reclamación Virtual</h5>
                    <p class="card-text text-muted flex-grow-1">Registrar una reclamación desde la plataforma web.</p>
                    <div class="d-grid gap-2 mt-3">
                        <a href="#" class="btn btn-primary">Registrar</a>
                        <a href="#" class="btn btn-outline-secondary">Volver a Módulos</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Reclamación para Vivienda -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border">
                <div class="card-body text-center d-flex flex-column">
                    <h5 class="card-title fw-bold">Reclamación para Vivienda</h5>
                    <p class="card-text text-muted flex-grow-1">Registrar una reclamación relacionada con una vivienda.</p>
                    <div class="d-grid gap-2 mt-3">
                        <a href="#" class="btn btn-primary">Registrar</a>
                        <a href="#" class="btn btn-outline-secondary">Volver a Módulos</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Barrio o Sector -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border">
                <div class="card-body text-center d-flex flex-column">
                    <h5 class="card-title fw-bold">Barrio o Sector</h5>
                    <p class="card-text text-muted flex-grow-1">Reportes comunitarios.</p>
                    <div class="mt-3">
                        <a href="#" class="btn btn-secondary px-4">Ver</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Seguimiento -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border">
                <div class="card-body text-center d-flex flex-column">
                    <h5 class="card-title fw-bold">Seguimiento</h5>
                    <p class="card-text text-muted flex-grow-1">Consulte el estado de su reclamación.</p>
                    <div class="mt-3">
                        <a href="#" class="btn btn-dark px-4">Consultar</a>
                    </div>
                </div>
            </div>
        </div>



    </div>
</div>