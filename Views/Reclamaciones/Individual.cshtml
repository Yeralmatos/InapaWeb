@model InapaWeb.Models.Reclamacion

@{
    ViewData["Title"] = "Reclamación Individual";
}

<h2 class="mb-4">Registrar Reclamación Individual</h2>


<form asp-action="Registrar" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="IdCliente" />


    <div class="mb-3">
        <label class="form-label">
            Cliente
        </label>

        <input class="form-control"
               value="@ViewBag.NombreCliente"
               readonly />
    </div>



    <div class="mb-3">
        <label class="form-label">
            Tipo de reclamación
        </label>

        <input asp-for="TipoReclamacion"
               class="form-control"
               readonly />

    </div>



    <div class="mb-3">
        <label class="form-label">
            Descripción de la reclamación
        </label>


        <textarea asp-for="Descripcion"
                  class="form-control"
                  rows="5"
                  placeholder="Describa el problema..."></textarea>


        <span asp-validation-for="Descripcion"
              class="text-danger">
        </span>

    </div>



    <button type="submit"
            class="btn btn-primary">
        Enviar reclamación
    </button>



    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>


</form>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}