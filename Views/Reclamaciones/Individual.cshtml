@model InapaWeb.Models.Reclamacion

<div class="container my-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                Registrar Reclamación Individual
            </h3>
        </div>


        <div class="card-body">

            <form asp-controller="Reclamaciones"
                  asp-action="Registrar"
                  method="post"
                  enctype="multipart/form-data">


                @Html.AntiForgeryToken()


                <!-- Mostrar errores -->
                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>



                <input type="hidden" asp-for="IdCliente" />

                <input type="hidden" asp-for="TipoReclamacion" />

                <input type="hidden" asp-for="Estado" />

                <input type="hidden" asp-for="FechaRegistro" />



                <!-- Cliente -->
                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Cliente
                    </label>

                    <input class="form-control"
                           value="@ViewBag.NombreCliente"
                           readonly />

                </div>




                <!-- Tipo -->
                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Tipo de reclamación
                    </label>

                    <input class="form-control"
                           value="Individual"
                           readonly />

                </div>




                <!-- Descripción -->
                <div class="mb-3">

                    <label asp-for="Descripcion"
                           class="form-label fw-bold">
                        Descripción de la reclamación
                    </label>


                    <textarea asp-for="Descripcion"
                              class="form-control"
                              rows="5"
                              placeholder="Escriba su reclamación aquí..."
                              required></textarea>


                    <span asp-validation-for="Descripcion"
                          class="text-danger">
                    </span>

                </div>




                <!-- Evidencia -->
                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Evidencia
                    </label>


                    <input type="file"
                           name="archivoEvidencia"
                           class="form-control" />


                    <small class="text-muted">
                        Puede adjuntar una imagen como evidencia.
                    </small>

                </div>




                <!-- Botones -->
                <div class="mt-4">


                    <button type="submit"
                            class="btn btn-primary">
                        Enviar reclamación
                    </button>



                    <a asp-controller="Reclamaciones"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancelar
                    </a>


                </div>


            </form>


        </div>

    </div>

</div>



@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}