@model IEnumerable<InapaWeb.Models.Reclamacion>

@{
    ViewData["Title"] = "Seguimiento de Reclamaciones";
}

<div class="container mt-4">

    <h2>Seguimiento de Reclamaciones</h2>
    <hr />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    <table class="table table-bordered table-striped">

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Cliente</th>
                <th>Descripción</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.IdReclamacion</td>

                    <td>@item.IdCliente</td>

                    <td>@item.Descripcion</td>

                    <td>
                        <span class="badge bg-warning text-dark">
                            @item.Estado
                        </span>
                    </td>

                    <td>

                        <a asp-action="Detalle"
                           asp-route-id="@item.IdReclamacion"
                           class="btn btn-info btn-sm">
                            Detalle
                        </a>

                        <a asp-action="Atencion"
                           asp-route-id="@item.IdReclamacion"
                           class="btn btn-primary btn-sm">
                            Atender
                        </a>

                        <a asp-action="Cerrar"
                           asp-route-id="@item.IdReclamacion"
                           class="btn btn-danger btn-sm">
                            Cerrar
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>