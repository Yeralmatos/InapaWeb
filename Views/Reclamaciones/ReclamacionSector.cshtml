@{
    ViewData["Title"] = "Reclamación Sector";
}

<h1>Reclamación para Barrio o Sector</h1>

<form>

    <div>
        <label>Nombre del barrio o sector:</label>
        <input type="text" class="form-control" />
    </div>

    <br />

    <div>
        <label>Municipio:</label>
        <input type="text" class="form-control" />
    </div>

    <br />

    <div>
        <label>Cantidad aproximada de afectados:</label>
        <input type="number" class="form-control" />
    </div>

    <br />

    <div>
        <label>Descripción de la reclamación:</label>
        <textarea class="form-control"></textarea>
    </div>

    <br />

    <div>
        <label>Evidencias:</label>
        <input type="file" class="form-control" />
    </div>

    <br />

    <button type="submit" class="btn btn-primary">
        Registrar Reclamación del Sector
    </button>

</form>