@{
    Layout = null;

    var nombreUsuario =
        ViewBag.NombreUsuario ?? "Técnico";

    int totalAsignados =
        ViewBag.TotalAsignados ?? 0;

    int totalEnProceso =
        ViewBag.TotalEnProceso ?? 0;

    int totalFinalizados =
        ViewBag.TotalFinalizados ?? 0;

    int totalTrabajos =
        ViewBag.TotalTrabajos ?? 0;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Panel Técnico - INAPA</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f3f6fb;
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #10213f;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        /* =====================================================
                   MENÚ LATERAL
                ===================================================== */

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 270px;
            height: 100vh;
            padding: 24px 18px;
            overflow-y: auto;
            color: white;
            background: linear-gradient(180deg, #063d86, #001d49);
            z-index: 1000;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 13px;
            padding-bottom: 24px;
            margin-bottom: 22px;
            border-bottom: 1px solid rgba(255, 255, 255, .18);
        }

            .brand img {
                width: 65px;
                height: 65px;
                object-fit: contain;
            }

            .brand h2 {
                margin: 0;
                font-size: 29px;
                font-weight: 800;
            }

            .brand small {
                display: block;
                margin-top: 3px;
                font-size: 11px;
                line-height: 1.45;
                opacity: .88;
            }

        .menu a {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 8px;
            padding: 13px 14px;
            border-radius: 11px;
            color: white;
            text-decoration: none;
            font-size: 15px;
            transition: .2s ease;
        }

            .menu a:hover,
            .menu a.active {
                background: #0d6efd;
                color: white;
                transform: translateX(2px);
            }

        .menu i {
            width: 24px;
            text-align: center;
            font-size: 21px;
        }

        .logout-link {
            margin-top: 24px;
            border: 1px solid rgba(255, 255, 255, .25);
        }

        /* =====================================================
                   CONTENIDO
                ===================================================== */

        .main {
            width: calc(100% - 270px);
            min-height: 100vh;
            margin-left: 270px;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            min-height: 78px;
            padding: 12px 34px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            background: white;
            border-bottom: 1px solid #e1e7ef;
        }

        .topbar-title {
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .topbar-title i {
                font-size: 25px;
                color: #06469b;
            }

            .topbar-title h4 {
                margin: 0;
                font-weight: 800;
            }

        .user-box {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #0d6efd;
            color: white;
            font-size: 25px;
        }

        .user-box strong {
            display: block;
        }

        .user-box small {
            color: #718096;
        }

        .content {
            flex: 1;
            padding: 30px 34px;
        }

        /* =====================================================
                   BIENVENIDA
                ===================================================== */

        .welcome {
            padding: 27px 30px;
            margin-bottom: 24px;
            border-radius: 20px;
            color: white;
            background: linear-gradient(135deg, #06469b, #002e70);
            box-shadow: 0 14px 34px rgba(2, 48, 112, .20);
        }

            .welcome h2 {
                margin: 0 0 7px;
                font-size: 29px;
                font-weight: 800;
            }

            .welcome p {
                margin: 0;
                opacity: .9;
            }

        /* =====================================================
                   TARJETAS
                ===================================================== */

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 24px;
        }

        .summary-card {
            min-height: 170px;
            padding: 21px;
            border: 1px solid #e1e7ef;
            border-radius: 17px;
            background: white;
            box-shadow: 0 8px 23px rgba(16, 33, 63, .07);
        }

        .summary-icon {
            width: 55px;
            height: 55px;
            margin-bottom: 14px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 27px;
        }

        .icon-total {
            background: #e8f1ff;
            color: #0d6efd;
        }

        .icon-assigned {
            background: #fff3cd;
            color: #b77900;
        }

        .icon-process {
            background: #cff4fc;
            color: #087990;
        }

        .icon-finished {
            background: #d1e7dd;
            color: #146c43;
        }

        .summary-card h6 {
            margin-bottom: 5px;
            color: #52627a;
            font-weight: 700;
        }

        .summary-number {
            font-size: 31px;
            font-weight: 800;
            color: #10213f;
        }

        .summary-card small {
            color: #718096;
        }

        /* =====================================================
                   ACCESO PRINCIPAL
                ===================================================== */

        .work-panel {
            display: grid;
            grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
            gap: 20px;
        }

        .main-card,
        .information-card {
            border: 1px solid #e1e7ef;
            border-radius: 18px;
            background: white;
            box-shadow: 0 8px 24px rgba(16, 33, 63, .07);
        }

        .main-card {
            padding: 25px;
        }

        .main-card-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 20px;
        }

            .main-card-header h4 {
                margin: 0 0 5px;
                font-weight: 800;
            }

            .main-card-header p {
                margin: 0;
                color: #718096;
            }

        .large-icon {
            width: 64px;
            height: 64px;
            border-radius: 17px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e8f1ff;
            color: #0d6efd;
            font-size: 31px;
            flex-shrink: 0;
        }

        .main-action {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding: 21px;
            border: 1px solid #dce5f0;
            border-radius: 15px;
            background: #f8fbff;
        }

            .main-action h5 {
                margin: 0 0 5px;
                font-weight: 800;
            }

            .main-action p {
                margin: 0;
                color: #718096;
            }

            .main-action .btn {
                padding: 11px 18px;
                border-radius: 11px;
                font-weight: 700;
                white-space: nowrap;
            }

        .information-card {
            padding: 24px;
        }

            .information-card h5 {
                margin-bottom: 18px;
                font-weight: 800;
            }

        .information-item {
            display: flex;
            gap: 13px;
            padding: 14px 0;
            border-bottom: 1px solid #edf1f5;
        }

            .information-item:last-child {
                border-bottom: none;
            }

            .information-item i {
                font-size: 20px;
                color: #0d6efd;
            }

            .information-item strong {
                display: block;
                margin-bottom: 2px;
            }

            .information-item small {
                color: #718096;
            }

        .footer {
            padding: 16px 30px;
            background: #003b82;
            color: white;
            text-align: center;
        }

        /* =====================================================
                   RESPONSIVE
                ===================================================== */

        @@media (max-width: 1150px) {
            .summary-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .work-panel {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 850px) {
            .layout {
                display: block;
            }

            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
            }

            .main {
                width: 100%;
                margin-left: 0;
            }

            .topbar {
                padding: 14px 20px;
            }

            .content {
                padding: 22px 17px;
            }
        }

        @@media (max-width: 580px) {
            .summary-grid {
                grid-template-columns: 1fr;
            }

            .topbar {
                align-items: flex-start;
                flex-direction: column;
            }

            .main-action {
                align-items: flex-start;
                flex-direction: column;
            }

                .main-action .btn {
                    width: 100%;
                }

            .welcome {
                padding: 22px;
            }

                .welcome h2 {
                    font-size: 24px;
                }
        }
    </style>
</head>

<body>

    <div class="layout">

        <aside class="sidebar">

            <div class="brand">

                <img src="/images/inapa-logo.png"
                     alt="Logo INAPA" />

                <div>
                    <h2>INAPA</h2>

                    <small>
                        Instituto Nacional de Aguas<br />
                        Potables y Alcantarillados
                    </small>
                </div>

            </div>

            <nav class="menu">

                <a asp-controller="Tecnico"
                   asp-action="Index"
                   class="active">

                    <i class="bi bi-house-door-fill"></i>
                    Inicio
                </a>

                <a asp-controller="Tecnico"
                   asp-action="TrabajosAsignados">

                    <i class="bi bi-clipboard2-check-fill"></i>
                    Trabajos asignados
                </a>

                <a asp-controller="Tecnico"
                   asp-action="TrabajosAsignados"
                   asp-route-estado="Asignado">

                    <i class="bi bi-hourglass-split"></i>
                    Pendientes
                </a>

                <a asp-controller="Tecnico"
                   asp-action="TrabajosAsignados"
                   asp-route-estado="En Proceso">

                    <i class="bi bi-arrow-repeat"></i>
                    En proceso
                </a>

                <a asp-controller="Tecnico"
                   asp-action="TrabajosAsignados"
                   asp-route-estado="Finalizado">

                    <i class="bi bi-check2-circle"></i>
                    Finalizados
                </a>

                <a asp-controller="Acceso"
                   asp-action="CerrarSesion"
                   class="logout-link">

                    <i class="bi bi-box-arrow-left"></i>
                    Cerrar sesión
                </a>

            </nav>

        </aside>

        <main class="main">

            <header class="topbar">

                <div class="topbar-title">
                    <i class="bi bi-tools"></i>
                    <h4>Panel Técnico</h4>
                </div>

                <div class="user-box">

                    <div class="avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <div>
                        <strong>@nombreUsuario</strong>
                        <small>Técnico</small>
                    </div>

                </div>

            </header>

            <section class="content">

                <div class="welcome">

                    <h2>
                        ¡Bienvenido, @nombreUsuario!
                    </h2>

                    <p>
                        Consulta tus trabajos asignados, realiza levantamientos
                        técnicos y reporta los resultados al administrador.
                    </p>

                </div>

                <section class="summary-grid">

                    <div class="summary-card">

                        <div class="summary-icon icon-total">
                            <i class="bi bi-clipboard-data-fill"></i>
                        </div>

                        <h6>Total de trabajos</h6>

                        <div class="summary-number">
                            @totalTrabajos
                        </div>

                        <small>Trabajos registrados</small>

                    </div>

                    <div class="summary-card">

                        <div class="summary-icon icon-assigned">
                            <i class="bi bi-hourglass-split"></i>
                        </div>

                        <h6>Trabajos asignados</h6>

                        <div class="summary-number">
                            @totalAsignados
                        </div>

                        <small>Pendientes de iniciar</small>

                    </div>

                    <div class="summary-card">

                        <div class="summary-icon icon-process">
                            <i class="bi bi-arrow-repeat"></i>
                        </div>

                        <h6>En proceso</h6>

                        <div class="summary-number">
                            @totalEnProceso
                        </div>

                        <small>Levantamientos iniciados</small>

                    </div>

                    <div class="summary-card">

                        <div class="summary-icon icon-finished">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>

                        <h6>Finalizados</h6>

                        <div class="summary-number">
                            @totalFinalizados
                        </div>

                        <small>Trabajos completados</small>

                    </div>

                </section>

                <section class="work-panel">

                    <div class="main-card">

                        <div class="main-card-header">

                            <div>
                                <h4>
                                    <i class="bi bi-clipboard2-check-fill"></i>
                                    Gestión de trabajos
                                </h4>

                                <p>
                                    Consulta los levantamientos técnicos que te fueron asignados.
                                </p>
                            </div>

                            <div class="large-icon">
                                <i class="bi bi-tools"></i>
                            </div>

                        </div>

                        <div class="main-action">

                            <div>
                                <h5>Trabajos asignados</h5>

                                <p>
                                    Abre un trabajo para consultar los datos del cliente,
                                    iniciar el levantamiento y registrar el resultado.
                                </p>
                            </div>

                            <a asp-controller="Tecnico"
                               asp-action="TrabajosAsignados"
                               class="btn btn-primary">

                                <i class="bi bi-folder2-open"></i>
                                Ver trabajos
                            </a>

                        </div>

                    </div>

                    <aside class="information-card">

                        <h5>
                            <i class="bi bi-info-circle-fill"></i>
                            Proceso técnico
                        </h5>

                        <div class="information-item">

                            <i class="bi bi-1-circle-fill"></i>

                            <div>
                                <strong>Abre la asignación</strong>
                                <small>Consulta los datos del cliente y la solicitud.</small>
                            </div>

                        </div>

                        <div class="information-item">

                            <i class="bi bi-2-circle-fill"></i>

                            <div>
                                <strong>Realiza el levantamiento</strong>
                                <small>Evalúa las condiciones del lugar del servicio.</small>
                            </div>

                        </div>

                        <div class="information-item">

                            <i class="bi bi-3-circle-fill"></i>

                            <div>
                                <strong>Registra el resultado</strong>
                                <small>Envía las observaciones y finaliza el trabajo.</small>
                            </div>

                        </div>

                    </aside>

                </section>

            </section>

            <footer class="footer">
                © 2026 INAPA - Instituto Nacional de Aguas Potables y Alcantarillados.
            </footer>

        </main>

    </div>

</body>
</html>
