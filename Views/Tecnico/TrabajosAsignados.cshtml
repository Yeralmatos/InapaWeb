@model List<InapaWeb.Models.AsignacionTecnico>

@{
    Layout = null;

    string estadoSeleccionado =
        ViewBag.EstadoSeleccionado as string ?? "Todos";

    string tituloPagina =
        estadoSeleccionado == "Asignado"
            ? "Trabajos pendientes"
            : estadoSeleccionado == "En Proceso"
                ? "Trabajos en proceso"
                : estadoSeleccionado == "Finalizado"
                    ? "Trabajos finalizados"
                    : "Trabajos asignados";

    string descripcionPagina =
        estadoSeleccionado == "Asignado"
            ? "Trabajos asignados que todavía no han sido iniciados."
            : estadoSeleccionado == "En Proceso"
                ? "Levantamientos técnicos que se encuentran en ejecución."
                : estadoSeleccionado == "Finalizado"
                    ? "Trabajos técnicos que ya fueron completados."
                    : "Todos los trabajos asignados por Coordinación Técnica.";

    string mensajeVacio =
        estadoSeleccionado == "Asignado"
            ? "No tienes trabajos pendientes."
            : estadoSeleccionado == "En Proceso"
                ? "No tienes trabajos en proceso."
                : estadoSeleccionado == "Finalizado"
                    ? "No tienes trabajos finalizados."
                    : "No tienes trabajos asignados.";

    int asignados = ViewBag.TotalAsignados ?? 0;
    int proceso = ViewBag.TotalEnProceso ?? 0;
    int finalizados = ViewBag.TotalFinalizados ?? 0;
}

<!DOCTYPE html>
<html lang="es">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@tituloPagina - INAPA</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f4f7fb;
            font-family: "Segoe UI", Arial, sans-serif;
            color: #10213f;
        }

        .page-shell {
            min-height: 100vh;
            padding: 28px;
        }

        .titulo {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            padding: 25px 28px;
            margin-bottom: 25px;
            border-radius: 18px;
            color: white;
            background: linear-gradient(135deg, #1785ed, #10298d);
            box-shadow: 0 10px 25px rgba(0, 0, 0, .12);
        }

            .titulo h2 {
                margin: 0 0 6px;
                font-weight: 800;
            }

            .titulo p {
                margin: 0;
                opacity: .9;
            }

        .btn-volver {
            border: none;
            border-radius: 11px;
            padding: 11px 17px;
            background: white;
            color: #173c8d;
            font-weight: 700;
            text-decoration: none;
            white-space: nowrap;
        }

            .btn-volver:hover {
                background: #edf4ff;
                color: #0e2c72;
            }

        .mensajes {
            margin-bottom: 20px;
        }

            .mensajes .alert {
                border: none;
                border-radius: 13px;
                font-weight: 600;
            }

        .filtros {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 20px;
        }

        .filtro-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 15px;
            border: 1px solid #d5deeb;
            border-radius: 10px;
            background: white;
            color: #314461;
            font-weight: 700;
            text-decoration: none;
        }

            .filtro-btn:hover {
                border-color: #176fd0;
                color: #1763b4;
                background: #f5f9ff;
            }

            .filtro-btn.activo {
                border-color: #176fd0;
                background: #176fd0;
                color: white;
            }

        .resumen-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 24px;
        }

        .resumen-enlace {
            color: inherit;
            text-decoration: none;
        }

        .resumen {
            display: flex;
            align-items: center;
            gap: 15px;
            min-height: 105px;
            padding: 20px;
            border-radius: 16px;
            background: white;
            border: 1px solid #e3e9f2;
            box-shadow: 0 8px 20px rgba(0, 0, 0, .06);
            transition: transform .2s, box-shadow .2s;
        }

            .resumen:hover {
                transform: translateY(-3px);
                box-shadow: 0 12px 28px rgba(0, 0, 0, .1);
            }

            .resumen.seleccionado {
                border-color: #1671d5;
                box-shadow: 0 0 0 3px rgba(22, 113, 213, .1);
            }

        .resumen-icon {
            width: 54px;
            height: 54px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 25px;
            flex-shrink: 0;
        }

        .icon-pending {
            background: #fff3cd;
            color: #997404;
        }

        .icon-process {
            background: #cfe2ff;
            color: #084298;
        }

        .icon-finished {
            background: #d1e7dd;
            color: #0f5132;
        }

        .resumen small {
            display: block;
            color: #718096;
        }

        .resumen strong {
            display: block;
            font-size: 27px;
        }

        .tabla-card {
            border: none;
            border-radius: 18px;
            overflow: hidden;
            background: white;
            box-shadow: 0 8px 20px rgba(0, 0, 0, .08);
        }

        .tabla-encabezado {
            padding: 19px 22px;
            border-bottom: 1px solid #e8edf5;
        }

            .tabla-encabezado h3 {
                margin: 0;
                font-size: 19px;
                font-weight: 800;
            }

            .tabla-encabezado span {
                color: #748198;
                font-size: 14px;
            }

        .table-wrap {
            overflow-x: auto;
        }

        .table {
            margin: 0;
        }

            .table thead th {
                padding: 15px 14px;
                background: #eef4fb;
                color: #28415f;
                font-size: 13px;
                text-transform: uppercase;
                letter-spacing: .04em;
                white-space: nowrap;
            }

            .table tbody td {
                padding: 16px 14px;
                vertical-align: middle;
                border-color: #edf1f6;
            }

        .request-code {
            color: #06469b;
            font-weight: 800;
            white-space: nowrap;
        }

        .client-name {
            font-weight: 700;
            color: #182844;
        }

        .client-email {
            margin-top: 3px;
            color: #7a879b;
            font-size: 12px;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 11px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
            white-space: nowrap;
        }

        .status-assigned {
            background: #fff3cd;
            color: #664d03;
        }

        .status-process {
            background: #cfe2ff;
            color: #084298;
        }

        .status-finished {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-other {
            background: #e9ecef;
            color: #495057;
        }

        .btn-abrir {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            border: none;
            border-radius: 9px;
            padding: 9px 13px;
            background: #19a7ce;
            color: white;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            white-space: nowrap;
        }

            .btn-abrir:hover {
                background: #118aac;
                color: white;
            }

        .empty-state {
            padding: 60px 20px;
            text-align: center;
            color: #718096;
        }

            .empty-state i {
                display: block;
                margin-bottom: 14px;
                font-size: 52px;
                color: #9fb3c8;
            }

            .empty-state h4 {
                color: #28415f;
                font-weight: 800;
            }

        @@media (max-width: 850px) {
            .page-shell {
                padding: 16px;
            }

            .titulo {
                align-items: flex-start;
                flex-direction: column;
            }

            .btn-volver {
                width: 100%;
                text-align: center;
            }

            .resumen-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>

</head>

<body>

    <div class="page-shell">

        <header class="titulo">

            <div>
                <h2>
                    <i class="bi bi-tools"></i>
                    @tituloPagina
                </h2>

                <p>@descripcionPagina</p>
            </div>

            <a asp-controller="Tecnico"
               asp-action="Index"
               class="btn-volver">

                <i class="bi bi-arrow-left"></i>
                Volver al panel

            </a>

        </header>

        <div class="mensajes">

            @if (TempData["Exito"] != null)
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["Exito"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @TempData["Error"]
                </div>
            }

        </div>

        <nav class="filtros">

            <a asp-controller="Tecnico"
               asp-action="TrabajosAsignados"
               class="filtro-btn @(estadoSeleccionado == "Todos" ? "activo" : "")">

                <i class="bi bi-list-ul"></i>
                Todos

            </a>

            <a asp-controller="Tecnico"
               asp-action="TrabajosAsignados"
               asp-route-estado="Asignado"
               class="filtro-btn @(estadoSeleccionado == "Asignado" ? "activo" : "")">

                <i class="bi bi-hourglass-split"></i>
                Pendientes

            </a>

            <a asp-controller="Tecnico"
               asp-action="TrabajosAsignados"
               asp-route-estado="En Proceso"
               class="filtro-btn @(estadoSeleccionado == "En Proceso" ? "activo" : "")">

                <i class="bi bi-arrow-repeat"></i>
                En proceso

            </a>

            <a asp-controller="Tecnico"
               asp-action="TrabajosAsignados"
               asp-route-estado="Finalizado"
               class="filtro-btn @(estadoSeleccionado == "Finalizado" ? "activo" : "")">

                <i class="bi bi-check-circle"></i>
                Finalizados

            </a>

        </nav>

        <section class="resumen-grid">

            <a asp-controller="Tecnico"
               asp-action="TrabajosAsignados"
               asp-route-estado="Asignado"
               class="resumen-enlace">

                <div class="resumen @(estadoSeleccionado == "Asignado" ? "seleccionado" : "")">

                    <div class="resumen-icon icon-pending">
                        <i class="bi bi-hourglass-split"></i>
                    </div>

                    <div>
                        <small>Pendientes</small>
                        <strong>@asignados</strong>
                    </div>

                </div>

            </a>

            <a asp-controller="Tecnico"
               asp-action="TrabajosAsignados"
               asp-route-estado="En Proceso"
               class="resumen-enlace">

                <div class="resumen @(estadoSeleccionado == "En Proceso" ? "seleccionado" : "")">

                    <div class="resumen-icon icon-process">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>

                    <div>
                        <small>En proceso</small>
                        <strong>@proceso</strong>
                    </div>

                </div>

            </a>

            <a asp-controller="Tecnico"
               asp-action="TrabajosAsignados"
               asp-route-estado="Finalizado"
               class="resumen-enlace">

                <div class="resumen @(estadoSeleccionado == "Finalizado" ? "seleccionado" : "")">

                    <div class="resumen-icon icon-finished">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>

                    <div>
                        <small>Finalizados</small>
                        <strong>@finalizados</strong>
                    </div>

                </div>

            </a>

        </section>

        <main class="tabla-card">

            <div class="tabla-encabezado">

                <h3>Listado de trabajos</h3>

                <span>
                    Registros encontrados: @(Model?.Count ?? 0)
                </span>

            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="empty-state">

                    <i class="bi bi-inbox-fill"></i>

                    <h4>@mensajeVacio</h4>

                    <p class="mb-0">
                        No existen registros que coincidan con esta sección.
                    </p>

                </div>
            }
            else
            {
                <div class="table-wrap">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Solicitud</th>
                                <th>Cliente</th>
                                <th>Trabajo</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                string nombreCliente =
                                item.SolicitudServicio?.Cliente?.Usuario?.NombreUsuario
                                ?? "Cliente no disponible";

                                string correoCliente =
                                item.SolicitudServicio?.Cliente?.Usuario?.Correo
                                ?? "";

                                <tr>

                                    <td>
                                        <span class="request-code">
                                            SOL-@item.IdSolicitud.ToString("D5")
                                        </span>
                                    </td>

                                    <td>

                                        <div class="client-name">
                                            @nombreCliente
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(correoCliente))
                                        {
                                            <div class="client-email">
                                                @correoCliente
                                            </div>
                                        }

                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.TipoTrabajo)
                                                                    ? "Trabajo técnico"
                                                                    : item.TipoTrabajo)
                            </td>

                                    <td>

                                        @item.FechaAsignacion.ToString("dd/MM/yyyy")

                                        <br />

                                        <small class="text-muted">
                                            @item.FechaAsignacion.ToString("hh:mm tt")
                                        </small>

                                    </td>

                                    <td>

                                @if (item.Estado == "Asignado")
                                        {
                                            <span class="status-badge status-assigned">
                                                <i class="bi bi-hourglass-split"></i>
                                                Pendiente
                                            </span>
                                        }
                                        else if (item.Estado == "En Proceso")
                                        {
                                            <span class="status-badge status-process">
                                                <i class="bi bi-arrow-repeat"></i>
                                                En proceso
                                            </span>
                                        }
                                        else if (item.Estado == "Finalizado")
                                        {
                                            <span class="status-badge status-finished">
                                                <i class="bi bi-check-circle-fill"></i>
                                                Finalizado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-other">
                                                <i class="bi bi-info-circle"></i>
                                                @item.Estado
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <a asp-controller="Tecnico"
                                           asp-action="DetalleTrabajo"
                                           asp-route-id="@item.IdAsignacion"
                                           class="btn-abrir">

                                            <i class="bi bi-folder2-open"></i>

                                            @if (item.Estado == "Finalizado")
                                            {
                                                <span>Ver resultado</span>
                                            }
                                            else
                                            {
                                                <span>Abrir trabajo</span>
                                            }

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </main>

    </div>

</body>
</html>
