@model List<InapaWeb.Models.AsignacionTecnico>

@{
    Layout = null;

    var estadoSeleccionado =
        ViewBag.EstadoSeleccionado as string ?? "Todos";

    string tituloPagina =
        estadoSeleccionado == "Asignado"
            ? "Trabajos Pendientes"
            : estadoSeleccionado == "En Proceso"
                ? "Trabajos en Proceso"
                : estadoSeleccionado == "Finalizado"
                    ? "Trabajos Finalizados"
                    : "Trabajos Asignados";

    string descripcionPagina =
        estadoSeleccionado == "Asignado"
            ? "Trabajos asignados que aún no han sido iniciados."
            : estadoSeleccionado == "En Proceso"
                ? "Levantamientos técnicos que se encuentran en ejecución."
                : estadoSeleccionado == "Finalizado"
                    ? "Trabajos técnicos que ya fueron completados."
                    : "Todos los trabajos enviados por el administrador.";

    string mensajeVacio =
        estadoSeleccionado == "Asignado"
            ? "No tienes trabajos pendientes."
            : estadoSeleccionado == "En Proceso"
                ? "No tienes trabajos en proceso."
                : estadoSeleccionado == "Finalizado"
                    ? "No tienes trabajos finalizados."
                    : "No tienes trabajos asignados.";

    int asignados = ViewBag.TotalAsignados ?? 0;
    int proceso = ViewBag.TotalEnProceso ?? 0;
    int finalizados = ViewBag.TotalFinalizados ?? 0;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@tituloPagina - INAPA</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f4f7fb;
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #10213f;
        }

        .page-shell {
            min-height: 100vh;
            padding: 28px;
        }

        .titulo {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            padding: 25px 28px;
            margin-bottom: 25px;
            border-radius: 18px;
            color: white;
            background: linear-gradient(135deg, #0d6efd, #0b4bb3);
            box-shadow: 0 10px 25px rgba(0, 0, 0, .12);
        }

            .titulo h2 {
                margin: 0 0 6px;
                font-weight: 800;
            }

            .titulo p {
                margin: 0;
                opacity: .9;
            }

        .resumen-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 24px;
        }

        .resumen {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 20px;
            border-radius: 16px;
            background: white;
            border: 1px solid #e3e9f2;
            box-shadow: 0 8px 20px rgba(0, 0, 0, .06);
        }

        .resumen-icon {
            width: 54px;
            height: 54px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 25px;
            flex-shrink: 0;
        }

        .icon-pending {
            background: #fff3cd;
            color: #997404;
        }

        .icon-process {
            background: #cfe2ff;
            color: #084298;
        }

        .icon-finished {
            background: #d1e7dd;
            color: #0f5132;
        }

        .resumen small {
            display: block;
            color: #718096;
        }

        .resumen strong {
            display: block;
            font-size: 27px;
        }

        .card {
            border: none;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 8px 20px rgba(0, 0, 0, .08);
        }

        .table-wrap {
            overflow-x: auto;
        }

        .table {
            margin: 0;
        }

            .table thead th {
                padding: 15px 14px;
                background: #eef4fb;
                color: #28415f;
                font-size: 13px;
                text-transform: uppercase;
                letter-spacing: .04em;
                white-space: nowrap;
            }

            .table tbody td {
                padding: 16px 14px;
                vertical-align: middle;
                border-color: #edf1f6;
            }

        .request-code {
            color: #06469b;
            font-weight: 800;
        }

        .client-name {
            font-weight: 700;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 11px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
        }

        .status-assigned {
            background: #fff3cd;
            color: #664d03;
        }

        .status-process {
            background: #cfe2ff;
            color: #084298;
        }

        .status-finished {
            background: #d1e7dd;
            color: #0f5132;
        }

        .empty-state {
            padding: 60px 20px;
            text-align: center;
            color: #718096;
        }

            .empty-state i {
                display: block;
                margin-bottom: 14px;
                font-size: 52px;
                color: #9fb3c8;
            }

            .empty-state h4 {
                color: #28415f;
                font-weight: 800;
            }

        @@media (max-width: 850px) {
            .page-shell {
                padding: 16px;
            }

            .titulo {
                align-items: flex-start;
                flex-direction: column;
            }

                .titulo .btn {
                    width: 100%;
                }

            .resumen-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <div class="page-shell">

        <div class="titulo">

            <div>
                <h2>
                    <i class="bi bi-tools"></i>
                    @tituloPagina
                </h2>

                <p>
                    @descripcionPagina
                </p>
            </div>

            <a asp-controller="Tecnico"
               asp-action="Index"
               class="btn btn-light">

                <i class="bi bi-arrow-left"></i>
                Volver al panel
            </a>

        </div>

        <section class="resumen-grid">

            <div class="resumen">
                <div class="resumen-icon icon-pending">
                    <i class="bi bi-hourglass-split"></i>
                </div>

                <div>
                    <small>Pendientes</small>
                    <strong>@asignados</strong>
                </div>
            </div>

            <div class="resumen">
                <div class="resumen-icon icon-process">
                    <i class="bi bi-arrow-repeat"></i>
                </div>

                <div>
                    <small>En proceso</small>
                    <strong>@proceso</strong>
                </div>
            </div>

            <div class="resumen">
                <div class="resumen-icon icon-finished">
                    <i class="bi bi-check-circle-fill"></i>
                </div>

                <div>
                    <small>Finalizados</small>
                    <strong>@finalizados</strong>
                </div>
            </div>

        </section>

        <div class="card">

            @if (Model == null || !Model.Any())
            {
                <div class="empty-state">

                    <i class="bi bi-inbox-fill"></i>

                    <h4>@mensajeVacio</h4>

                    <p class="mb-0">
                        No existen registros que coincidan con esta sección.
                    </p>

                </div>
            }
            else
            {
                <div class="table-wrap">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Solicitud</th>
                                <th>Cliente</th>
                                <th>Trabajo</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        <span class="request-code">
                                            SOL-@item.IdSolicitud.ToString("00000")
                                        </span>
                                    </td>

                                    <td>
                                        <div class="client-name">
                                            @(item.SolicitudServicio?.Cliente?.Usuario?.NombreUsuario
                                                                                ?? "Cliente no disponible")
                                </div>
                            </td>

                                    <td>
                                        @item.TipoTrabajo
                                    </td>

                                    <td>
                                        @item.FechaAsignacion.ToString("dd/MM/yyyy")
                                        <br />

                                        <small class="text-muted">
                                            @item.FechaAsignacion.ToString("hh:mm tt")
                                        </small>
                                    </td>

                                    <td>
                                @if (item.Estado == "Asignado")
                                        {
                                            <span class="status-badge status-assigned">
                                                <i class="bi bi-hourglass-split"></i>
                                                Pendiente
                                            </span>
                                        }
                                        else if (item.Estado == "En Proceso")
                                        {
                                            <span class="status-badge status-process">
                                                <i class="bi bi-arrow-repeat"></i>
                                                En proceso
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-finished">
                                                <i class="bi bi-check-circle-fill"></i>
                                                Finalizado
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <a asp-controller="Tecnico"
                                           asp-action="DetalleTrabajo"
                                           asp-route-id="@item.IdAsignacion"
                                           class="btn btn-info btn-sm text-white">

                                            <i class="bi bi-folder2-open"></i>
                                            Abrir trabajo
                                        </a>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</body>
</html>
