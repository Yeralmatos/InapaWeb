@using Microsoft.AspNetCore.Http

@{
    var nombreUsuario =
        Context.Session.GetString("NombreUsuario") ?? "Cliente";

    var accionActual =
        ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - INAPA</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #f3f6fb;
            color: #0b1f44;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 280px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            overflow-y: auto;
            padding: 22px 16px;
            background: linear-gradient( 180deg, #063c82 0%, #06285d 55%, #031a3d 100% );
            color: white;
            box-shadow: 5px 0 25px rgba(0, 24, 64, .18);
            z-index: 1000;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 4px 8px 22px;
            border-bottom: 1px solid rgba(255, 255, 255, .15);
        }

            .brand img {
                width: 60px;
                height: 60px;
                object-fit: contain;
                flex-shrink: 0;
            }

            .brand h2 {
                margin: 0;
                font-size: 27px;
                font-weight: 800;
                letter-spacing: .5px;
            }

            .brand small {
                display: block;
                margin-top: 2px;
                font-size: 10px;
                line-height: 1.35;
                color: rgba(255, 255, 255, .78);
            }

        .client-summary {
            display: flex;
            align-items: center;
            gap: 11px;
            margin: 18px 3px;
            padding: 13px;
            border-radius: 14px;
            background: rgba(255, 255, 255, .09);
            border: 1px solid rgba(255, 255, 255, .10);
        }

        .client-avatar {
            width: 43px;
            height: 43px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ffffff;
            color: #0752b3;
            font-size: 22px;
            flex-shrink: 0;
        }

        .client-summary strong {
            display: block;
            max-width: 165px;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            font-size: 14px;
        }

        .client-summary span {
            font-size: 12px;
            color: rgba(255, 255, 255, .72);
        }

        .menu-section {
            margin: 20px 12px 8px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.4px;
            color: rgba(255, 255, 255, .48);
            text-transform: uppercase;
        }

        .menu a {
            display: flex;
            align-items: center;
            gap: 13px;
            min-height: 48px;
            margin-bottom: 5px;
            padding: 11px 13px;
            border-radius: 12px;
            color: rgba(255, 255, 255, .88);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all .2s ease;
        }

            .menu a i {
                width: 24px;
                text-align: center;
                font-size: 19px;
            }

            .menu a:hover {
                color: white;
                background: rgba(255, 255, 255, .11);
                transform: translateX(3px);
            }

            .menu a.active {
                background: white;
                color: #064594;
                font-weight: 700;
                box-shadow: 0 8px 20px rgba(0, 0, 0, .15);
            }

            .menu a.logout {
                margin-top: 16px;
                color: #ffd9d9;
                border: 1px solid rgba(255, 255, 255, .10);
            }

                .menu a.logout:hover {
                    background: #b42332;
                    color: white;
                }

        .main {
            width: calc(100% - 280px);
            min-height: 100vh;
            margin-left: 280px;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            min-height: 76px;
            padding: 12px 34px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: white;
            border-bottom: 1px solid #e2e8f0;
            box-shadow: 0 2px 12px rgba(15, 40, 80, .04);
        }

        .topbar-title h5 {
            margin: 0;
            font-weight: 750;
            color: #0b1f44;
        }

        .topbar-title small {
            color: #718096;
        }

        .topbar-user {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .topbar-avatar {
            width: 44px;
            height: 44px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e8f1ff;
            color: #0752b3;
            font-size: 22px;
        }

        .topbar-user strong {
            display: block;
            font-size: 14px;
        }

        .topbar-user small {
            color: #718096;
        }

        .content {
            flex: 1;
            padding: 30px 34px;
        }

        .footer {
            padding: 17px 30px;
            text-align: center;
            color: #718096;
            background: white;
            border-top: 1px solid #e4eaf2;
            font-size: 13px;
        }

        @@media (max-width: 850px) {
            .layout {
                display: block;
            }

            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
            }

            .main {
                width: 100%;
                margin-left: 0;
            }

            .topbar {
                padding: 14px 18px;
            }

            .content {
                padding: 22px 18px;
            }
        }

        @@media (max-width: 576px) {
            .topbar-title {
                display: none;
            }
        }
    </style>

    @RenderSection("Styles", required: false)
</head>

<body>

    <div class="layout">

        <aside class="sidebar">

            <div class="brand">

                <img src="/images/inapa-logo.png"
                     alt="Logo INAPA" />

                <div>
                    <h2>INAPA</h2>

                    <small>
                        Instituto Nacional de Aguas<br />
                        Potables y Alcantarillados
                    </small>
                </div>

            </div>

            <div class="client-summary">

                <div class="client-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div>
                    <strong>@nombreUsuario</strong>
                    <span>Portal del cliente</span>
                </div>

            </div>

            <nav class="menu">

                <div class="menu-section">
                    Principal
                </div>

                <a asp-controller="Cliente"
                   asp-action="Index"
                   class="@(accionActual == "Index" ? "active" : "")">

                    <i class="bi bi-grid-fill"></i>
                    Inicio
                </a>

                <div class="menu-section">
                    Gestiones
                </div>

                <a asp-controller="Cliente"
                   asp-action="NuevaSolicitud"
                   class="@(accionActual == "NuevaSolicitud" ? "active" : "")">

                    <i class="bi bi-file-earmark-plus-fill"></i>
                    Solicitar servicio
                </a>

                <a asp-controller="Cliente"
                   asp-action="MisSolicitudes"
                   class="@(accionActual == "MisSolicitudes" ? "active" : "")">

                    <i class="bi bi-list-check"></i>
                    Mis solicitudes
                </a>

                <a asp-controller="Cliente"
                   asp-action="MiContrato"
                   class="@(
                   accionActual == "MiContrato" ||
                   accionActual == "SolicitarContrato"
                       ? "active"
                       : ""
                                      )">

                    <i class="bi bi-file-earmark-text-fill"></i>
                    Mi contrato
                </a>

                <div class="menu-section">
                    Facturación
                </div>

                <a asp-controller="Cliente"
                   asp-action="MisFacturas"
                   class="@(accionActual == "MisFacturas" ? "active" : "")">

                    <i class="bi bi-receipt-cutoff"></i>
                    Mis facturas
                </a>

                <a asp-controller="Cliente"
                   asp-action="MisPagos"
                   class="@(accionActual == "MisPagos" ? "active" : "")">

                    <i class="bi bi-wallet2"></i>
                    Mis pagos
                </a>

                <div class="menu-section">
                    Atención
                </div>

                <a href="#">
                    <i class="bi bi-tools"></i>
                    Reportar avería
                </a>

                <a href="#">
                    <i class="bi bi-chat-square-text-fill"></i>
                    Reclamaciones
                </a>

                <a href="#">
                    <i class="bi bi-bell-fill"></i>
                    Notificaciones
                </a>

                <div class="menu-section">
                    Cuenta
                </div>

                <a href="#">
                    <i class="bi bi-person-circle"></i>
                    Mi perfil
                </a>

                <a asp-controller="Acceso"
                   asp-action="CerrarSesion"
                   class="logout">

                    <i class="bi bi-box-arrow-left"></i>
                    Cerrar sesión
                </a>

            </nav>

        </aside>

        <main class="main">

            <header class="topbar">

                <div class="topbar-title">

                    <h5>
                        @(ViewData["Title"] ?? "Panel del cliente")
                    </h5>

                    <small>
                        Gestiona tus servicios de manera sencilla
                    </small>

                </div>

                <div class="topbar-user">

                    <div class="topbar-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <div>
                        <strong>@nombreUsuario</strong>
                        <small>Cliente</small>
                    </div>

                </div>

            </header>

            <section class="content">

                @if (TempData["Mensaje"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show"
                         role="alert">

                        <i class="bi bi-check-circle-fill me-1"></i>
                        @TempData["Mensaje"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>

                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show"
                         role="alert">

                        <i class="bi bi-exclamation-circle-fill me-1"></i>
                        @TempData["Error"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>

                    </div>
                }

                @RenderBody()

            </section>

            <footer class="footer">
                © 2026 INAPA - Instituto Nacional de Aguas Potables y Alcantarillados
            </footer>

        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>
